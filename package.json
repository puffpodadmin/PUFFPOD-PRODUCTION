      p.layeredPodCard = true;
    }
  });

  const ring = document.getElementById('ring');
  const dotsWrap = document.getElementById('dots');
  // V22: os novos IGNITE V400 MIX ficam somente em Todos os produtos; não entram neste carrossel.
  const ringProducts = [products[8], products[9], products[10], products[11], products[12]];
  const count = ringProducts.length;
  let current = 0;
  let timer = null;

  ringProducts.forEach((p, i) => {
    const card = document.createElement('div');
    card.style.setProperty('--card-glow', p.glow);

    if(p.bg){
      card.className = 'card photo-card';
      card.innerHTML = `
        <div class="photo-bg"><img src="${p.bg}" alt=""></div>
        <div class="pod-float"><img src="${p.image}" alt="${p.name}"></div>
        <div class="ring-caption">
          <h3>${p.name}</h3>
          <span class="price">${p.price}</span>
        </div>
      `;
    } else {
      card.className = 'card';
      const media = p.image
        ? `<img src="${p.image}" alt="${p.name}">`
        : `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${p.icon}</svg>`;
      card.innerHTML = `
        <div class="card-icon-only${p.image ? ' has-photo' : ''}">
          ${media}
        </div>
        <div class="card-caption">
          <h3>${p.name}</h3>
          <span class="price">${p.price}</span>
        </div>
      `;
      card.querySelector('.card-icon-only').style.animationDelay = (i * 0.18) + 's';
    }
    ring.appendChild(card);
    card.dataset.productId = p.id;
    card.addEventListener('click', () => window.openProductModal(p));

    const dot = document.createElement('button');
    dot.className = 'dot';
    dot.setAttribute('aria-label', `Ir para ${p.name}`);
    dot.addEventListener('click', () => goTo(i));
    dotsWrap.appendChild(dot);
  });

  const cards = ring.querySelectorAll('.card');
  const dots = dotsWrap.querySelectorAll('.dot');

  function shortestOffset(i, activeIdx){
    let diff = ((i - activeIdx) % count + count) % count;
    if(diff > count / 2) diff -= count;
    return diff;
  }

  function cardTransform(offset){
    if(offset === 0) return 'translateX(0) translateZ(0) rotateY(0deg) scale(1)';
    const isMobile = window.innerWidth < 640;
    const sign = offset > 0 ? 1 : -1;
    const abs = Math.min(Math.abs(offset), 2);
    const spacing = isMobile ? [0, 128, 224] : [0, 210, 368];
    const angle   = isMobile ? [0, 32, 46]  : [0, 34, 48];
    const scale   = [1, 0.86, 0.7];
    const depth   = isMobile ? [0, -36, -96] : [0, -55, -130];
    return `translateX(${sign * spacing[abs]}px) translateZ(${depth[abs]}px) rotateY(${-sign * angle[abs]}deg) scale(${scale[abs]})`;
  }

  function render(){
    const activeIdx = ((current % count) + count) % count;
    cards.forEach((c, i) => {
      const offset = shortestOffset(i, activeIdx);
      c.style.transform = cardTransform(offset);
      c.style.zIndex = 100 - Math.abs(offset);
      c.classList.toggle('is-active', offset === 0);
      c.classList.toggle('is-adjacent', Math.abs(offset) === 1);
    });
    dots.forEach((d, i) => d.classList.toggle('active', i === activeIdx));
  }
  function goTo(i){ current = i; render(); restart(); }
  function next(){ current++; render(); }
  function prev(){ current--; render(); }
  function restart(){ clearInterval(timer); timer = setInterval(next, 3500); }

  document.getElementById('nextBtn').addEventListener('click', () => { next(); restart(); });
  document.getElementById('prevBtn').addEventListener('click', () => { prev(); restart(); });

  const stage = document.getElementById('stage');

  // swipe touch support
  (function(){
    let startX = 0, startY = 0, dragging = false;
    stage.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      startX = t.clientX; startY = t.clientY; dragging = true;
      clearInterval(timer);
    }, { passive:true });
    stage.addEventListener('touchmove', (e) => {
      if(!dragging) return;
      const t = e.touches[0];
      const dx = t.clientX - startX, dy = t.clientY - startY;
      if(Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10){ e.preventDefault(); }
    }, { passive:false });
    stage.addEventListener('touchend', (e) => {
      if(!dragging) return;
      dragging = false;
      const t = e.changedTouches[0];
      const dx = t.clientX - startX, dy = t.clientY - startY;
      if(Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)){
        dx < 0 ? next() : prev();
      }
      restart();
    }, { passive:true });
  })();

  render();
  restart();
})();

/* ---------- cart ---------- */
(function(){
  const cart = {}; // name -> { product, qty }

  const cartBar = document.getElementById('cartBar');
  const cartCountEl = document.getElementById('cartCount');
  const cartTotalEl = document.getElementById('cartTotal');
  const cartDrawer = document.getElementById('cartDrawer');
  const cartScrim = document.getElementById('cartScrim');
  const cartItemsWrap = document.getElementById('cartItems');
  const cartDrawerTotal = document.getElementById('cartDrawerTotal');
  const cartViewBtn = document.getElementById('cartViewBtn');
  const cartClose = document.getElementById('cartClose');
  const cartCheckoutBtn = document.getElementById('cartCheckoutBtn');

  function toBRL(n){ return 'R$ ' + Math.round(n).toLocaleString('pt-BR'); }
  const priceOf = str => parseFloat(str.replace('R$','').trim().replace(/\./g,'').replace(',', '.'));

  function totals(){
    let count = 0, total = 0;
    Object.values(cart).forEach(item => {
      count += item.qty;
      total += item.qty * priceOf(item.product.price);
    });
    return { count, total };
  }

  function openDrawer(){ cartDrawer.classList.add('open'); cartScrim.classList.add('open'); document.body.style.overflow='hidden'; }
  function closeDrawer(){ cartDrawer.classList.remove('open'); cartScrim.classList.remove('open'); document.body.style.overflow=''; }
  window.openPuffCart = openDrawer;
  window.closePuffCart = closeDrawer;

  function renderDrawer(){
    const items = Object.values(cart);
    if(items.length === 0){
      cartItemsWrap.innerHTML = '<p class="cart-empty">Seu carrinho está vazio.<br>Adicione produtos da vitrine.</p>';
      return;
    }
    cartItemsWrap.innerHTML = items.map(item => `
      <div class="cart-item" data-name="${item.product.name}">
        <div class="cart-item-icon${item.product.image ? ' has-photo' : ''}" style="--card-glow:${item.product.glow}">
          ${item.product.image ? `<img src="${item.product.image}" alt="${item.product.name}">` : `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${item.product.icon}</svg>`}
        </div>
        <div class="cart-item-info">
          <div class="name">${item.product.name}</div>
          <div class="unit">${item.product.price} un.</div>
        </div>
        <div class="cart-item-qty">
          <button class="qty-btn" data-action="dec" aria-label="Diminuir quantidade">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" data-action="inc" aria-label="Aumentar quantidade">+</button>
        </div>
        <button class="cart-item-remove" data-action="remove">remover</button>
      </div>
    `).join('');

    cartItemsWrap.querySelectorAll('.cart-item').forEach(row => {
      const name = row.dataset.name;
      row.querySelector('[data-action="inc"]').addEventListener('click', () => changeQty(name, 1));
      row.querySelector('[data-action="dec"]').addEventListener('click', () => changeQty(name, -1));
      row.querySelector('[data-action="remove"]').addEventListener('click', () => { delete cart[name]; update(); });
    });
  }

  window.refreshCartPrices = function(){
    Object.values(cart).forEach(item=>{const latest=(window.PRODUCTS||[]).find(p=>p.id===item.product.id);if(latest)item.product=latest;});
    update();
  };

  function updateCheckoutLink(){
    const items = Object.values(cart).map(item => ({
      id: item.product.id,
      name: item.product.name,
      price: priceOf(item.product.price),
      qty: item.qty,
      glow: item.product.glow
    }));
    const encoded = encodeURIComponent(JSON.stringify(items));
    cartCheckoutBtn.href = 'checkout.html?cart=' + encoded;
  }

  function update(){
    const { count, total } = totals();
    cartCountEl.textContent = count;
    cartTotalEl.textContent = toBRL(total);
    cartDrawerTotal.textContent = toBRL(total);
    cartBar.classList.toggle('visible', count > 0);
    cartCheckoutBtn.classList.toggle('disabled', count === 0);
    renderDrawer();
    updateCheckoutLink();
  }

  function pulseBar(){
    cartBar.classList.remove('pulse');
    void cartBar.offsetWidth;
    cartBar.classList.add('pulse');
  }

  function changeQty(name, delta){
    if(!cart[name]) return;
    cart[name].qty += delta;
    if(cart[name].qty <= 0) delete cart[name];
    update();
  }

  window.addToCart = function(product){
    if(!cart[product.name]) cart[product.name] = { product, qty:0 };
    cart[product.name].qty++;
    update();
    pulseBar();
  };

  cartCheckoutBtn.addEventListener('click', (e) => {
    if(Object.keys(cart).length === 0) e.preventDefault();
  });

  cartViewBtn.addEventListener('click', openDrawer);
  cartClose.addEventListener('click', closeDrawer);
  cartScrim.addEventListener('click', closeDrawer);

  update();
})();

