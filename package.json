  const scrim = document.getElementById('scrim');

  function close(){
    toggle.classList.remove('open');
    panel.classList.remove('open');
    scrim.classList.remove('open');
    toggle.setAttribute('aria-expanded','false');
    document.body.style.overflow = '';
  }
  function open(){
    toggle.classList.add('open');
    panel.classList.add('open');
    scrim.classList.add('open');
    toggle.setAttribute('aria-expanded','true');
    document.body.style.overflow = 'hidden';
  }
  toggle.addEventListener('click', () => {
    panel.classList.contains('open') ? close() : open();
  });
  scrim.addEventListener('click', close);
  panel.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', close));
})();

/* ---------- ambient smoke generator (imagens reais) ---------- */
(function(){
  const SMOKE_SRCS = [
    "assets/embedded/38f113c307ea5c0d.png",
    "assets/embedded/179e7635a8e7851a.png",
    "assets/embedded/fbbc3725dea03cd1.png",
    "assets/embedded/59d433ea3b324021.png",
    "assets/embedded/c1df78b968735314.png"
  ];

  function spawnBubbles(containerId, count){
    const el = document.getElementById(containerId);
    if(!el) return;
    for(let i=0;i<count;i++){
      const b = document.createElement('div');
      b.className = 'foam';
      const width = 70 + Math.random()*110;
      b.style.width = width+'px';
      b.style.left = (Math.random()*88)+'%';
      b.style.top = (Math.random()*84)+'%';
      b.style.animationDuration = (7 + Math.random()*9)+'s';
      b.style.animationDelay = (Math.random()*5)+'s';
      b.style.opacity = (0.3 + Math.random()*0.35).toFixed(2);
      const img = document.createElement('img');
      img.src = SMOKE_SRCS[Math.floor(Math.random()*SMOKE_SRCS.length)];
      img.alt = '';
      b.appendChild(img);
      el.appendChild(b);
    }
  }
  spawnBubbles('heroBubbles', 6);
  spawnBubbles('contatoBubbles', 5);
  spawnBubbles('footerBubbles', 5);
})();

