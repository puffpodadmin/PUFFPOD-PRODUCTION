<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#04121c">
<link rel="icon" type="image/png" sizes="128x128" href="assets/puffpod-favicon.png">
<link rel="apple-touch-icon" href="assets/puffpod-favicon.png">
<title>Puffpod - Pods Descartáveis</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --deep:#031b2e;
    --panel:#062a44;
    --panel-2:#0a3a5c;
    --line: rgba(255,255,255,0.10);
    --teal:#00b4d8;
    --aqua:#48cae4;
    --foam:#caf0f8;
    --seafoam:#2ec4b6;
    --midblue:#0077b6;
    --ink:#eaf6fb;
    --muted:#7fa8c9;
    --radius:22px;
    --wave-footer-img:url(assets/embedded/8d22aa6f6eb308d7.png);
    --smoke-corner-img:url(assets/embedded/fbbc3725dea03cd1.png);
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}

  body{
    background:linear-gradient(180deg, var(--deep), #04121f 40%, #030d18);
    color:var(--ink);
    font-family:'Manrope', sans-serif;
    overflow-x:hidden;
    position:relative;
  }

  ::selection{ background:var(--teal); color:#031b2e; }

  h1,h2,h3,.display{
    font-family:'Baloo 2', sans-serif;
    letter-spacing:-0.01em;
    line-height:1.08;
  }
  .mono{ font-family:'JetBrains Mono', monospace; letter-spacing:0.04em; }
  a{ color:inherit; text-decoration:none; }
  button{ font-family:inherit; }

  section{ position:relative; z-index:1; padding:110px clamp(20px,5vw,64px); }
  .section-head{ text-align:center; max-width:640px; margin:0 auto 60px; }
  .section-head .eyebrow{ margin:0 auto 18px; width:fit-content; }
  .section-head h2{ font-size:clamp(1.9rem,4vw,3rem); font-weight:700; }
  .section-head p{ color:var(--muted); margin-top:16px; font-size:1.02rem; }

  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:0.76rem; letter-spacing:0.2em; text-transform:uppercase;
    color:var(--aqua);
    display:inline-flex; align-items:center; gap:10px;
    padding:8px 16px; border:1px solid rgba(72,202,228,0.4);
    border-radius:999px; background:rgba(72,202,228,0.08);
  }
  .eyebrow .pulse{
    width:7px; height:7px; border-radius:50%; background:var(--aqua);
    box-shadow:0 0 8px 2px var(--aqua);
    animation:blink 1.8s ease-in-out infinite;
  }
  @keyframes blink{ 50%{ opacity:.25; } }

  /* ---------- floating smoke/foam (ambient, imagens reais) ---------- */
  .bubbles{ position:absolute; inset:0; overflow:hidden; z-index:0; pointer-events:none; }
  .foam{
    position:absolute;
    animation:floaty linear infinite;
    filter:drop-shadow(0 0 10px rgba(202,240,248,0.25));
  }
  .foam img{ width:100%; height:auto; display:block; }
  @keyframes floaty{
    0%{ transform:translateY(10px) translateX(0) scale(1); }
    50%{ transform:translateY(-28px) translateX(14px) scale(1.04); }
    100%{ transform:translateY(10px) translateX(0) scale(1); }
  }

  /* ---------- wave divider strips (imagens reais) ---------- */
  .wave-strip{
    position:relative; width:100%; line-height:0; overflow:hidden;
    height:clamp(70px,9vw,150px);
    z-index:2;
  }
  .wave-strip img{ width:100%; height:100%; object-fit:cover; display:block; }
  .wave-strip.flip img{ transform:scaleY(-1); }

  /* ---------- illustrated full-width wave (hero) ---------- */
  .illustrated-wave{
    position:absolute; left:0; right:0; bottom:-2px; z-index:1;
    width:100%; height:clamp(150px, 22vw, 320px);
    pointer-events:none;
    overflow:hidden;
  }
  .illustrated-wave img{ width:100%; height:100%; object-fit:cover; object-position:bottom; display:block; }

  /* ---------- illustrated wave crest at footer top ---------- */
  .footer-wave{
    width:100%; height:clamp(120px, 16vw, 260px);
    margin-bottom:clamp(-70px, -8vw, -40px);
    pointer-events:none; position:relative; z-index:1;
    overflow:visible;
  }
  .footer-wave img{ width:100%; height:100%; object-fit:cover; object-position:bottom; display:block; }


  /* ---------- nav ---------- */
  header{
    position:fixed; top:0; left:0; right:0; z-index:200;
    display:flex; align-items:center; gap:22px;
    padding:14px clamp(18px,2.2vw,34px);
    backdrop-filter:blur(16px);
    background:rgba(3,27,46,0.55);
    border-bottom:1px solid var(--line);
  }
  .logo{ display:flex; align-items:center; filter:drop-shadow(0 0 10px rgba(72,202,228,0.5)); transition:transform .3s, filter .3s; }
  .logo:hover{ transform:scale(1.04); filter:drop-shadow(0 0 16px rgba(46,196,182,0.7)); }
  .logo img{ display:block; width:auto; height:64px; object-fit:contain; }

  .nav-links{
    position:absolute; left:50%; transform:translateX(-50%);
    display:flex; align-items:center; justify-content:center;
    gap:clamp(14px,2vw,28px); margin-left:0;
    white-space:nowrap;
  }
  .desktop-account-area{
    margin-left:auto; display:flex; align-items:center; justify-content:flex-end;
  }

  .auth-trigger{
    display:flex; align-items:center; gap:7px;
    background:rgba(255,255,255,0.06); border:1px solid var(--line); border-radius:999px;
    padding:8px 16px; color:var(--ink); font-size:0.86rem; font-weight:600; cursor:pointer;
    transition:background .2s, border-color .2s;
  }
  .auth-trigger:hover{ background:rgba(255,255,255,0.12); border-color:var(--teal); }
  .auth-trigger svg{ width:17px; height:17px; stroke:var(--aqua); }
  @media (max-width:1100px){
    .nav-links{ gap:14px; }
    nav ul{ gap:16px; }
  }
  @media (max-width:860px){
    .nav-links, .desktop-account-area{ display:none; }
    .auth-trigger{ display:none; }
  }
  @media (max-width:860px){ .logo img{ height:50px; } }
  .auth-trigger[hidden]{ display:none !important; }


  /* ---------- logged account menu ---------- */
  .account-menu{
    position:fixed; top:74px; left:auto; right:auto; z-index:360;
    width:min(290px, calc(100vw - 28px));
    padding:10px;
    background:rgba(4,25,42,0.98);
    border:1px solid rgba(72,202,228,0.24);
    border-radius:18px;
    box-shadow:0 24px 60px rgba(0,0,0,.42);
    backdrop-filter:blur(18px);
  }
  .account-menu[hidden]{ display:none; }
  .account-menu-head{ padding:9px 10px 12px; border-bottom:1px solid var(--line); margin-bottom:6px; }
  .account-menu-head strong{ display:block; font-size:.9rem; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .account-menu-head span{ display:block; color:var(--muted); font-size:.72rem; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .account-menu-btn{
    width:100%; border:0; background:transparent; color:var(--ink);
    display:flex; align-items:center; gap:11px; text-align:left;
    padding:11px 12px; border-radius:12px; cursor:pointer;
    font-family:'Manrope',sans-serif; font-size:.84rem; font-weight:650;
    transition:background .2s ease, color .2s ease;
  }
  .account-menu-btn:hover{ background:rgba(72,202,228,.10); color:var(--aqua); }
  .account-menu-btn svg{ width:18px; height:18px; stroke:currentColor; flex:0 0 auto; }
  .account-menu-btn.logout{ color:#ff9a9d; margin-top:4px; border-top:1px solid var(--line); border-radius:0 0 12px 12px; }

  .account-detail-modal{ position:fixed; inset:0; z-index:370; display:flex; align-items:center; justify-content:center; padding:22px; }
  .account-detail-modal[hidden]{ display:none; }
  .account-detail-scrim{ position:absolute; inset:0; background:rgba(2,10,18,.8); backdrop-filter:blur(6px); }
  .account-detail-panel{
    position:relative; z-index:1; width:min(620px,100%); max-height:min(76vh,680px); overflow:auto;
    background:linear-gradient(160deg,#0a3653,#052238); border:1px solid rgba(72,202,228,.26);
    border-radius:24px; padding:24px; box-shadow:0 30px 80px rgba(0,0,0,.48);
  }
  .account-detail-panel h3{ font-family:'Baloo 2',sans-serif; font-size:1.25rem; margin:0 44px 5px 0; }
  .account-detail-sub{ color:var(--muted); font-size:.82rem; margin-bottom:18px; }
  .account-detail-close{ position:absolute; top:16px; right:16px; width:38px; height:38px; border-radius:50%; border:1px solid var(--line); background:rgba(0,0,0,.15); color:var(--ink); cursor:pointer; font-size:1rem; }
  .account-loading,.account-empty{ color:var(--muted); padding:24px 4px; text-align:center; }
  .account-order{ padding:14px; border:1px solid var(--line); border-radius:14px; background:rgba(2,18,31,.38); margin-bottom:10px; }
  .account-order-top{ display:flex; justify-content:space-between; gap:12px; align-items:flex-start; margin-bottom:8px; }
  .account-order-id{ font-weight:750; font-size:.84rem; }
  .account-order-date{ color:var(--muted); font-size:.72rem; white-space:nowrap; }
  .account-order-items{ color:#c9dce8; font-size:.78rem; line-height:1.5; }
  .account-order-total{ margin-top:9px; color:var(--aqua); font-family:'JetBrains Mono',monospace; font-weight:700; }
  .cashback-box{ border:1px solid rgba(72,202,228,.28); border-radius:18px; padding:24px; text-align:center; background:rgba(72,202,228,.07); }
  .cashback-box small{ display:block; color:var(--muted); margin-bottom:5px; }
  .cashback-box strong{ font-family:'JetBrains Mono',monospace; font-size:2rem; color:var(--aqua); }
  .cashback-box p{ color:var(--muted); font-size:.78rem; margin:10px 0 0; }
  @media(max-width:860px){ .account-menu{ top:68px; } }
  .admin-trigger{ border-color:rgba(255,196,0,0.6); background:rgba(255,196,0,0.08); }
  .admin-trigger svg{ stroke:#ffc400; }
  .admin-trigger:hover{ background:rgba(255,196,0,0.16); border-color:#ffc400; }

  /* ---------- auth modal (login / cadastro) ---------- */
  .auth-modal{ position:fixed; inset:0; z-index:310; display:flex; align-items:center; justify-content:center; padding:24px; }
  .auth-modal[hidden]{ display:none; }
  .auth-modal-scrim{ position:absolute; inset:0; background:rgba(2,10,18,0.78); backdrop-filter:blur(6px); animation:pmFadeIn .3s ease; }
  .auth-modal-panel{
    position:relative; z-index:1; width:100%; max-width:420px; max-height:90vh; overflow-y:auto; overflow-x:hidden;
    background:linear-gradient(160deg, var(--panel-2), var(--panel));
    border:1px solid var(--line); border-radius:26px;
    padding:32px; box-shadow:0 40px 90px -20px rgba(0,0,0,0.6);
    animation:pmSlideUp .35s cubic-bezier(.22,.9,.35,1);
    box-sizing:border-box;
  }
  .auth-head{ margin-bottom:20px; padding-right:20px; }
  .auth-head h2{ font-family:'Baloo 2',sans-serif; font-size:1.3rem; font-weight:700; margin-bottom:6px; }
  .auth-head p{ color:var(--muted); font-size:0.86rem; line-height:1.5; }

  .auth-google-btn{
    width:100%; display:flex; align-items:center; justify-content:center; gap:10px;
    background:#fff; color:#1f1f1f; border:none; border-radius:999px; padding:13px 18px;
    font-weight:600; font-size:0.9rem; cursor:pointer; transition:transform .2s, box-shadow .2s;
  }
  .auth-google-btn:hover{ box-shadow:0 6px 18px rgba(0,0,0,0.25); transform:translateY(-1px); }
  .auth-google-btn:active{ transform:translateY(0); }

  .auth-divider{ display:flex; align-items:center; gap:12px; margin:20px 0; color:var(--muted); font-size:0.78rem; text-transform:uppercase; letter-spacing:0.08em; }
  .auth-divider::before, .auth-divider::after{ content:''; flex:1; height:1px; background:var(--line); }

  .auth-note{
    background:rgba(0,180,216,0.1); border:1px solid rgba(0,180,216,0.3); border-radius:12px;
    padding:10px 14px; font-size:0.82rem; color:var(--aqua); margin-bottom:16px; line-height:1.5;
  }

  .auth-form{ display:flex; flex-direction:column; gap:14px; }
  .auth-form[hidden]{ display:none; }
  .auth-submit{ width:100%; margin-top:4px; }

  .field{ display:flex; flex-direction:column; gap:6px; flex:none; min-width:0; }
  .field-row .field{ flex:1 1 140px; }
  .field span{
    font-family:'JetBrains Mono', monospace; font-size:0.68rem; letter-spacing:0.1em;
    text-transform:uppercase; color:var(--muted);
  }
  .field input{
    width:100%; box-sizing:border-box;
    background:rgba(255,255,255,0.05); border:1px solid var(--line); border-radius:12px;
    padding:12px 14px; color:var(--ink); font-size:0.92rem; font-family:inherit;
    transition:border-color .2s, box-shadow .2s;
  }
  .field input::placeholder{ color:rgba(127,168,201,0.6); }
  .field input:focus{ outline:none; border-color:var(--teal); box-shadow:0 0 0 3px rgba(0,180,216,0.18); }
  .field-row{ display:flex; gap:12px; flex-wrap:wrap; min-width:0; }
  @media (max-width:480px){ .field-row{ flex-direction:column; } }

  .auth-switch{ text-align:center; margin-top:18px; font-size:0.86rem; color:var(--muted); }
  .auth-switch button{
    background:none; border:none; color:var(--aqua); font-weight:600; cursor:pointer;
    font-size:0.86rem; padding:0; margin-left:4px; text-decoration:underline;
  }

  @media (max-width:520px){
    .auth-modal{ padding:0; align-items:flex-end; }
    .auth-modal-panel{ border-radius:22px 22px 0 0; max-height:94vh; }
  }

  /* ---------- admin panel ---------- */
  .admin-modal-panel{ max-width:640px; }
  .admin-tabs{ display:flex; gap:8px; flex-wrap:wrap; border-bottom:1px solid var(--line); margin-bottom:18px; padding-bottom:2px; }
  .admin-tab{
    background:none; border:none; color:var(--muted); font-weight:600; font-size:0.86rem;
    padding:8px 4px 12px; cursor:pointer; border-bottom:2px solid transparent; transition:color .2s, border-color .2s;
  }
  .admin-tab.active{ color:var(--ink); border-color:#ffc400; }
  .admin-panel-body{ min-height:120px; }
  .admin-hint{ color:var(--muted); font-size:0.82rem; line-height:1.5; margin-bottom:16px; }

  .admin-stat-grid{ display:flex; gap:14px; margin-bottom:16px; flex-wrap:wrap; }
  .admin-stat-card{
    flex:1 1 140px; background:rgba(255,255,255,0.04); border:1px solid var(--line); border-radius:14px;
    padding:16px; text-align:center;
  }
  .admin-stat-value{ display:block; font-family:'JetBrains Mono', monospace; font-size:1.6rem; font-weight:700; color:var(--aqua); }
  .admin-stat-label{ display:block; font-size:0.74rem; color:var(--muted); margin-top:4px; }

  .admin-period-buttons{ display:flex; gap:8px; margin-bottom:16px; }
  .admin-period-btn{
    flex:1; background:rgba(255,255,255,0.04); border:1px solid var(--line); border-radius:999px;
    padding:8px 10px; color:var(--ink); font-size:0.82rem; cursor:pointer; transition:background .2s, border-color .2s;
  }
  .admin-period-btn.active{ border-color:var(--teal); background:rgba(0,180,216,0.14); color:var(--aqua); }

  .admin-stock-list{ display:flex; flex-direction:column; gap:10px; max-height:360px; overflow-y:auto; }
  .admin-stock-row{
    display:flex; align-items:center; gap:12px; padding:10px 12px; border:1px solid var(--line);
    border-radius:12px; background:rgba(255,255,255,0.03);
  }
  .admin-stock-row .name{ flex:1; font-size:0.86rem; }
  .admin-stock-row .name small{ display:block; color:var(--muted); font-size:0.72rem; }
  .admin-toggle{
    position:relative; width:44px; height:24px; border-radius:999px; background:rgba(255,255,255,0.12);
    border:1px solid var(--line); cursor:pointer; flex-shrink:0; transition:background .2s;
  }
  .admin-toggle::after{
    content:''; position:absolute; top:2px; left:2px; width:18px; height:18px; border-radius:50%;
    background:#fff; transition:transform .2s;
  }
  .admin-toggle.on{ background:#e5484d; border-color:#e5484d; }
  .admin-toggle.on::after{ transform:translateX(20px); }

  .admin-nonbuyers-list{ display:flex; flex-direction:column; gap:10px; max-height:360px; overflow-y:auto; }
  .admin-orders-list{display:flex;flex-direction:column;gap:10px;max-height:430px;overflow-y:auto;padding-right:2px}
  .admin-order-row{border:1px solid var(--line);background:rgba(255,255,255,.035);border-radius:14px;padding:14px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:start}
  .admin-order-code{font-family:'JetBrains Mono',monospace;color:var(--aqua);font-size:.78rem;font-weight:700;margin-bottom:5px}
  .admin-order-name{font-weight:700;font-size:.88rem}.admin-order-meta{color:var(--muted);font-size:.73rem;line-height:1.5;margin-top:3px}
  .admin-order-address{color:#bdd6e4;font-size:.73rem;line-height:1.45;margin-top:8px}
  .admin-order-side{text-align:right;min-width:110px}.admin-order-total{font:700 .9rem 'JetBrains Mono',monospace;color:var(--foam);margin-bottom:7px}
  .admin-order-status{display:inline-flex;padding:5px 9px;border-radius:999px;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;border:1px solid rgba(255,255,255,.13);color:#b9d1df}
  .admin-order-status.paid{color:#75efb3;border-color:rgba(117,239,179,.28);background:rgba(117,239,179,.08)}
  .admin-order-status.pending{color:#ffd28c;border-color:rgba(255,210,140,.28);background:rgba(255,210,140,.08)}
  .admin-order-actions{display:flex;gap:6px;justify-content:flex-end;margin-top:9px;flex-wrap:wrap}
  @media(max-width:560px){.admin-order-row{grid-template-columns:1fr}.admin-order-side{text-align:left}.admin-order-actions{justify-content:flex-start}}

  .admin-nonbuyer-row{
    display:flex; align-items:center; gap:10px; padding:10px 12px; border:1px solid var(--line);
    border-radius:12px; background:rgba(255,255,255,0.03); flex-wrap:wrap;
  }
  .admin-nonbuyer-row .info{ flex:1; min-width:140px; }
  .admin-nonbuyer-row .info .name{ font-size:0.86rem; font-weight:600; }
  .admin-nonbuyer-row .info .email{ font-size:0.76rem; color:var(--muted); }
  .admin-mini-btn{
    display:flex; align-items:center; gap:5px; background:rgba(255,255,255,0.06); border:1px solid var(--line);
    border-radius:999px; padding:6px 12px; color:var(--ink); font-size:0.76rem; cursor:pointer; text-decoration:none;
    transition:background .2s;
  }
  .admin-mini-btn:hover{ background:rgba(255,255,255,0.14); }
  .admin-mini-btn svg{ width:14px; height:14px; }
  .admin-empty{ color:var(--muted); font-size:0.86rem; text-align:center; padding:20px 0; }
  .admin-user-tools{margin:4px 0 12px;}
  .admin-user-tools input{width:100%;border:1px solid var(--line);background:rgba(0,0,0,.2);color:var(--ink);border-radius:12px;padding:11px 13px;font:500 .82rem 'Manrope',sans-serif;outline:none;}
  .admin-user-tools input:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(0,180,216,.08);}
  .admin-users-list{display:flex;flex-direction:column;gap:9px;max-height:390px;overflow:auto;padding-right:2px;}
  .admin-user-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;border:1px solid var(--line);background:rgba(255,255,255,.035);border-radius:13px;padding:12px;}
  .admin-user-main{min-width:0}.admin-user-name{font-size:.85rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.admin-user-email{font-size:.72rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}.admin-user-ref{font:600 .68rem 'JetBrains Mono',monospace;color:var(--aqua);margin-top:5px;word-break:break-all}.admin-user-referred{font-size:.68rem;color:#b8ceda;margin-top:4px}
  .admin-ref-btn{border:1px solid rgba(72,202,228,.35);background:rgba(72,202,228,.08);color:var(--aqua);padding:7px 9px;border-radius:9px;font:700 .66rem 'Manrope',sans-serif;cursor:pointer;white-space:nowrap}.admin-ref-btn:hover{background:rgba(72,202,228,.16)}.admin-ref-btn.enabled{border-color:rgba(117,239,179,.3);color:#75efb3;background:rgba(117,239,179,.07)}
  .referral-card{border:1px solid rgba(72,202,228,.25);border-radius:16px;padding:18px;background:rgba(72,202,228,.06)}.referral-code{font:800 1.15rem 'JetBrains Mono',monospace;color:var(--aqua);letter-spacing:.04em;margin:8px 0}.referral-link{font-size:.75rem;color:var(--muted);word-break:break-all;line-height:1.5}.referral-copy{margin-top:12px;width:100%}
  .referral-earnings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0}.referral-earning{padding:13px;border-radius:13px;border:1px solid var(--line);background:rgba(255,255,255,.035)}.referral-earning small{display:block;color:var(--muted);font-size:.68rem;margin-bottom:5px}.referral-earning strong{font:800 .98rem 'JetBrains Mono',monospace;color:var(--foam)}
  .referral-withdraw{margin-top:12px;width:100%}.referral-withdraw-form{display:grid;gap:10px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}.referral-withdraw-form select,.referral-withdraw-form input{width:100%;border:1px solid var(--line);background:#05263d;color:var(--ink);border-radius:11px;padding:11px 12px;font:500 .8rem 'Manrope',sans-serif}.referral-withdraw-note{font-size:.72rem;color:var(--muted);line-height:1.5}.referral-success{padding:11px 13px;border-radius:11px;background:rgba(117,239,179,.08);border:1px solid rgba(117,239,179,.25);color:#9ff4ca;font-size:.78rem;margin-top:10px}
  .admin-user-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;justify-content:flex-end}.admin-rate-select{border:1px solid var(--line);background:#05263d;color:var(--ink);border-radius:9px;padding:7px 8px;font:700 .68rem 'Manrope',sans-serif}.admin-referrals-list{display:flex;flex-direction:column;gap:10px;max-height:360px;overflow:auto}.admin-referral-row{border:1px solid var(--line);background:rgba(255,255,255,.035);border-radius:14px;padding:13px}.admin-referral-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.admin-referral-name{font-weight:800;font-size:.86rem}.admin-referral-meta{font-size:.7rem;color:var(--muted);line-height:1.5;margin-top:4px}.admin-referral-code{font:700 .68rem 'JetBrains Mono',monospace;color:var(--aqua);margin-top:5px}.admin-referral-numbers{text-align:right;font-size:.7rem;color:#c6dde8}.admin-referral-invites{margin-top:10px;padding-top:10px;border-top:1px solid var(--line);display:grid;gap:6px}.admin-referral-invite{font-size:.72rem;color:#c7dce7;display:flex;justify-content:space-between;gap:8px}.admin-withdrawals-list{display:flex;flex-direction:column;gap:9px;margin-top:10px}.admin-withdrawal-row{border:1px solid var(--line);background:rgba(255,255,255,.03);border-radius:12px;padding:12px}.admin-withdrawal-actions{display:flex;gap:7px;margin-top:9px;flex-wrap:wrap}.admin-withdrawal-actions button{border:1px solid var(--line);background:rgba(255,255,255,.06);color:var(--ink);border-radius:9px;padding:7px 10px;cursor:pointer;font-weight:700;font-size:.7rem}.admin-withdrawal-actions .paid{border-color:rgba(117,239,179,.3);color:#75efb3}.admin-withdrawal-actions .reject{border-color:rgba(255,139,143,.3);color:#ff9b9f}
  @media(max-width:560px){.admin-user-row{grid-template-columns:1fr}.admin-ref-btn{width:100%}}

  nav ul{ display:flex; gap:clamp(16px,3vw,34px); list-style:none; }
  nav a{ font-size:0.86rem; font-weight:600; color:var(--muted); position:relative; transition:color .25s; }
  nav a:hover, nav a:focus-visible{ color:var(--ink); }
  nav a::after{ content:''; position:absolute; left:0; bottom:-6px; height:1px; width:0; background:var(--teal); transition:width .25s; }
  nav a:hover::after{ width:100%; }

  .btn{
    font-family:'Manrope',sans-serif; font-weight:700; font-size:0.85rem;
    padding:13px 26px; border-radius:999px;
    border:1px solid var(--teal); color:var(--foam);
    cursor:pointer; background:transparent;
    transition:all .3s ease; white-space:nowrap;
    touch-action:manipulation;
  }
  .btn:hover, .btn:focus-visible{ background:var(--teal); color:#031b2e; box-shadow:0 0 26px rgba(0,180,216,0.5); }
  .btn.solid{
    background:linear-gradient(135deg, var(--teal), var(--seafoam));
    border:none; color:#031b2e;
    box-shadow:0 0 30px rgba(46,196,182,0.35);
  }
  .btn.solid:hover{ box-shadow:0 0 42px rgba(46,196,182,0.6); transform:translateY(-2px); }

  .menu-toggle{
    display:none; flex-direction:column; justify-content:center; gap:5px;
    width:42px; height:42px; border-radius:12px; border:1px solid var(--line);
    background:rgba(255,255,255,0.03); cursor:pointer; align-items:center;
    touch-action:manipulation;
  }
  .header-mobile-actions{ display:none; align-items:center; gap:10px; margin-left:auto; }
  .auth-trigger-icon{
    display:none; align-items:center; justify-content:center; gap:7px;
    height:38px; padding:0 16px; border-radius:999px;
    border:1px solid rgba(72,202,228,0.55);
    background:rgba(6,42,68,0.6); color:var(--ink); cursor:pointer;
    box-shadow:0 0 14px -2px rgba(0,180,216,0.55), inset 0 0 10px rgba(0,180,216,0.08);
    font-size:0.86rem; font-weight:600; letter-spacing:0.01em;
    transition:background .2s, border-color .2s, box-shadow .2s, transform .2s;
  }
  .auth-trigger-icon:hover{
    background:rgba(10,58,92,0.75); border-color:var(--teal);
    box-shadow:0 0 20px -2px rgba(0,180,216,0.75), inset 0 0 12px rgba(0,180,216,0.12);
    transform:translateY(-1px);
  }
  .auth-trigger-icon:active{ transform:translateY(0); }
  .auth-trigger-icon svg{ width:17px; height:17px; stroke:var(--aqua); flex-shrink:0; }
  .menu-toggle span{
    width:20px; height:2px; background:var(--foam); border-radius:2px;
    transition:transform .3s, opacity .3s;
  }
  .menu-toggle.open span:nth-child(1){ transform:translateY(7px) rotate(45deg); }
  .menu-toggle.open span:nth-child(2){ opacity:0; }
  .menu-toggle.open span:nth-child(3){ transform:translateY(-7px) rotate(-45deg); }

  .mobile-panel{
    position:fixed; top:0; right:0; bottom:0;
    width:min(78vw, 320px); z-index:199;
    background:linear-gradient(180deg, #06263e, #031b2e);
    border-left:1px solid var(--line);
    padding:100px 32px 40px;
    display:flex; flex-direction:column; gap:26px;
    transform:translateX(100%);
    transition:transform .38s cubic-bezier(.22,.9,.35,1);
  }
  .mobile-panel.open{ transform:translateX(0); }
  .mobile-panel a{ font-size:1.05rem; font-weight:600; color:var(--ink); }
  .mobile-panel .btn{ text-align:center; }
  .scrim{
    position:fixed; inset:0; z-index:198;
    background:rgba(2,10,18,0.55); backdrop-filter:blur(2px);
    opacity:0; pointer-events:none; transition:opacity .3s;
  }
  .scrim.open{ opacity:1; pointer-events:auto; }

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    min-height:100vh; min-height:100dvh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:150px 20px 90px;
    z-index:1;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(0,180,216,0.16), transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 90%, rgba(46,196,182,0.12), transparent 60%);
  }

  .hero-banner{
    position:relative; z-index:2; width:100%; max-width:1180px;
    height:auto; aspect-ratio:16 / 9;
    border-radius:28px; overflow:hidden;
    border:1px solid var(--line);
    background:var(--panel);
  }
  .hero-slide{
    position:absolute; inset:0;
    display:block;
    opacity:0; transform:scale(1.04);
    transition:opacity 1s ease, transform 1.4s ease;
    pointer-events:none;
  }
  .hero-slide.is-active{ opacity:1; transform:scale(1); pointer-events:auto; }
  .hero-slide img{ width:100%; height:100%; object-fit:contain; display:block; background:#020812; }
  .hero-slide a.hero-slide-link{ display:block; width:100%; height:100%; cursor:pointer; }
  .hero-slide.no-link{ cursor:default; }

  .hero-arrow{
    position:absolute; top:50%; translate:0 -50%;
    width:46px; height:46px; border-radius:50%;
    border:1px solid var(--line); background:rgba(6,42,68,0.7); backdrop-filter:blur(6px);
    display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:5;
    transition:all .25s; touch-action:manipulation;
  }
  .hero-arrow:hover, .hero-arrow:focus-visible{ border-color:var(--teal); box-shadow:0 0 20px rgba(0,180,216,0.45); }
  .hero-arrow svg{ width:18px; height:18px; stroke:var(--ink); }
  .hero-arrow.prev{ left:16px; }
  .hero-arrow.next{ right:16px; }

  .dots{ display:flex; gap:10px; }
  .dot{ width:8px; height:8px; border-radius:50%; background:rgba(255,255,255,0.25); border:none; cursor:pointer; transition:all .3s; touch-action:manipulation; }
  .dot.active{ background:var(--teal); box-shadow:0 0 10px var(--teal); width:24px; border-radius:5px; }
  .hero-dots{ position:absolute; bottom:22px; left:50%; translate:-50% 0; display:flex; gap:10px; z-index:5; }

  /* ---------- vitrine / carousel ---------- */
  .vitrine{ background:var(--panel); }
  .stage{ position:relative; height:520px; display:flex; align-items:center; justify-content:center; perspective:1600px; }
  .ring{ position:relative; width:280px; height:380px; transform-style:preserve-3d; transition:transform 0.9s cubic-bezier(.22,.9,.35,1); }
  .card{
    position:absolute; inset:0; border-radius:var(--radius);
    background:linear-gradient(160deg, var(--panel-2), var(--panel));
    border:1px solid var(--line);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    backface-visibility:hidden;
    transition:opacity .6s, box-shadow .6s, border-color .6s, transform .7s cubic-bezier(.22,.9,.35,1);
    opacity:0.35;
    perspective:600px;
    cursor:pointer;
  }
  .card.is-active{
    opacity:1; border-color:rgba(72,202,228,0.5);
    box-shadow:0 0 50px -10px var(--card-glow, rgba(0,180,216,0.55)), inset 0 0 40px rgba(255,255,255,0.02);
  }
  .card.is-adjacent{
    opacity:0.72;
    border-color:rgba(72,202,228,0.28);
    box-shadow:0 0 26px -12px rgba(0,180,216,0.4);
  }

  .card-icon-only{
    position:relative;
    width:150px; height:150px;
    display:flex; align-items:center; justify-content:center;
    transform-style:preserve-3d;
    animation:iconJump 2.4s cubic-bezier(.45,0,.55,1) infinite;
  }
  .card-icon-only svg{
    width:120px; height:120px;
    stroke:var(--card-glow, var(--teal));
    filter:drop-shadow(0 0 18px var(--card-glow, var(--teal)));
    transition:filter .6s, opacity .6s;
  }
  .card:not(.is-active) .card-icon-only svg{ filter:none; opacity:.55; }
  .card:not(.is-active) .card-icon-only{ animation-play-state:paused; }

  .card-icon-only.has-photo img{
    width:132px; height:132px; object-fit:contain;
    filter:drop-shadow(0 10px 16px rgba(0,0,0,0.45)) drop-shadow(0 0 16px var(--card-glow, var(--teal)));
    transition:filter .6s, opacity .6s;
  }
  .card:not(.is-active) .card-icon-only.has-photo img{ filter:drop-shadow(0 6px 10px rgba(0,0,0,0.3)); opacity:.6; }

  @keyframes iconJump{
    0%, 100%{ transform:translateY(0) rotateX(0deg) scale(1); }
    35%{ transform:translateY(-30px) rotateX(10deg) scale(1.07); }
    55%{ transform:translateY(-22px) rotateX(6deg) scale(1.05); }
    80%{ transform:translateY(4px) rotateX(-4deg) scale(0.97); }
  }
  .card-icon-only::after{
    content:''; position:absolute; top:50%; left:50%; width:70px; height:14px; border-radius:50%;
    background:radial-gradient(ellipse, rgba(0,0,0,0.35), transparent 70%);
    transform:translate(-50%, 46px); z-index:-1;
    animation:iconShadow 2.4s cubic-bezier(.45,0,.55,1) infinite;
  }
  @keyframes iconShadow{
    0%, 100%{ opacity:0.4; transform:translate(-50%, 46px) scale(1); }
    35%{ opacity:0.12; transform:translate(-50%, 46px) scale(0.55); }
    55%{ opacity:0.16; transform:translate(-50%, 46px) scale(0.62); }
    80%{ opacity:0.45; transform:translate(-50%, 46px) scale(1.08); }
  }

  .card-caption{ margin-top:14px; text-align:center; }
  .card-caption h3{ font-size:1rem; font-weight:600; font-family:'Baloo 2',sans-serif; margin-bottom:4px; }
  .card-caption .price{ font-family:'JetBrains Mono', monospace; font-weight:600; font-size:0.88rem; color:var(--card-glow, var(--aqua)); }

  /* ---------- ring card photo variant: static bg + floating pod on top, covers whole card ---------- */
  .card.photo-card{
    justify-content:flex-end; overflow:hidden; padding:0;
  }
  .card.photo-card .photo-bg{
    position:absolute; inset:0; z-index:0;
  }
  .card.photo-card .photo-bg img{
    width:100%; height:100%; object-fit:cover; display:block;
  }
  .card.photo-card .pod-float{
    position:absolute; left:50%; top:40%; width:52%; z-index:1;
    transform:translate(-50%,-50%);
    filter:drop-shadow(0 20px 24px rgba(0,0,0,0.5));
    animation:podFloatGentle 4.4s ease-in-out infinite;
  }
  .card.photo-card .pod-float img{ width:100%; height:auto; display:block; }
  @keyframes podFloatGentle{
    0%, 100%{ transform:translate(-50%,-50%) translateY(0) rotate(-1.2deg); }
    50%{ transform:translate(-50%,-50%) translateY(-12px) rotate(1.2deg); }
  }
  .card.photo-card:not(.is-active) .pod-float{ animation-play-state:paused; opacity:.7; }
  .card.photo-card:not(.is-active) .photo-bg{ filter:brightness(0.7); }

  .card.is-adjacent .card-icon-only svg{ opacity:.8; filter:drop-shadow(0 0 8px var(--card-glow, var(--teal))); }
  .card.is-adjacent .card-icon-only.has-photo img{ opacity:.85; filter:drop-shadow(0 6px 10px rgba(0,0,0,0.35)); }
  .card.photo-card.is-adjacent .photo-bg{ filter:brightness(0.88); }
  .card.photo-card.is-adjacent .pod-float{ opacity:.85; animation-play-state:running; }

  .card.photo-card .ring-caption{
    position:relative; z-index:2; width:100%; text-align:center;
    padding:40px 16px 20px;
    background:linear-gradient(180deg, transparent, rgba(2,14,26,0.65) 45%, rgba(2,14,26,0.95) 100%);
  }
  .card.photo-card .ring-caption h3{ font-size:1rem; font-weight:600; font-family:'Baloo 2',sans-serif; margin-bottom:4px; text-shadow:0 2px 6px rgba(0,0,0,0.5); }
  .card.photo-card .ring-caption .price{ font-family:'JetBrains Mono', monospace; font-weight:600; font-size:0.88rem; color:var(--card-glow, var(--aqua)); }
  .card .price .old-price,.card .price .current-price{display:block;}
  .card .price .old-price{font-size:.72rem;color:rgba(255,255,255,.68);text-decoration:line-through;margin-bottom:2px;}
  .card .price .current-price{font-size:.9rem;font-weight:800;color:#7ee84f;}
  .card .promo-badge{top:12px;left:12px;z-index:12;}

  .stage-controls{ display:flex; align-items:center; justify-content:center; gap:22px; margin-top:44px; }

  /* ---------- catalog list + filters ---------- */
  .catalog{ max-width:1180px; margin:90px auto 0; }
  .catalog-head{
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap;
    gap:20px; margin-bottom:20px;
  }
  .catalog-head h3{ font-size:clamp(1.3rem,2.4vw,1.7rem); font-weight:700; }

  .filters-row{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .filters{ display:flex; gap:10px; flex-wrap:wrap; }
  .filter-chip{
    font-family:'Manrope',sans-serif; font-weight:600; font-size:0.82rem;
    padding:9px 18px; border-radius:999px;
    border:1px solid var(--line); background:var(--deep);
    color:var(--muted); cursor:pointer; transition:all .25s;
    touch-action:manipulation; white-space:nowrap;
  }
  .filter-chip:hover{ color:var(--ink); border-color:rgba(72,202,228,0.4); }
  .filter-chip.active{
    background:linear-gradient(135deg, var(--teal), var(--seafoam));
    border-color:transparent; color:#031b2e;
  }
  .filter-chip.clear{ background:transparent; border:1px solid rgba(255,255,255,0.18); }

  .filter-adv-toggle{
    width:40px; height:40px; border-radius:12px; flex-shrink:0;
    border:1px solid var(--line); background:var(--deep);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition:all .25s; touch-action:manipulation;
  }
  .filter-adv-toggle svg{ width:18px; height:18px; stroke:var(--muted); transition:stroke .25s; }
  .filter-adv-toggle:hover{ border-color:rgba(72,202,228,0.5); }
  .filter-adv-toggle:hover svg{ stroke:var(--ink); }
  .filter-adv-toggle.active{
    background:linear-gradient(135deg, var(--teal), var(--seafoam));
    border-color:transparent;
  }
  .filter-adv-toggle.active svg{ stroke:#031b2e; }
  .filter-adv-toggle.active svg circle{ fill:#031b2e; }

  .adv-panel{
    display:grid; grid-template-rows:0fr; opacity:0;
    transition:grid-template-rows .35s ease, opacity .3s ease, margin .35s ease;
    margin-bottom:0;
  }
  .adv-panel.open{ grid-template-rows:1fr; opacity:1; margin-bottom:28px; }
  .adv-panel > *{ overflow:hidden; }
  .adv-panel-inner{
    display:flex; align-items:flex-end; gap:28px; flex-wrap:wrap;
    padding:20px clamp(16px,3vw,26px);
    background:var(--deep); border:1px solid var(--line); border-radius:var(--radius);
  }
  .adv-group{ display:flex; flex-direction:column; gap:8px; }
  .adv-group label{ font-family:'JetBrains Mono',monospace; font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); }
  .adv-select{
    font-family:'Manrope',sans-serif; font-weight:600; font-size:0.86rem;
    padding:10px 14px; border-radius:10px;
    border:1px solid var(--line); background:var(--panel); color:var(--ink);
    cursor:pointer; min-width:170px;
  }

  .catalog-grid{
    display:grid; grid-template-columns:repeat(auto-fill, minmax(240px,1fr));
    gap:24px; perspective:1400px;
  }
  .catalog-card{
    position:relative; overflow:hidden; isolation:isolate;
    background:linear-gradient(160deg, var(--panel-2), var(--panel));
    border:1px solid var(--line); border-radius:var(--radius);
    padding:22px; display:flex; flex-direction:column;
    transform-style:preserve-3d; will-change:transform;
    transition:transform .45s cubic-bezier(.22,.9,.35,1), border-color .4s, box-shadow .4s;
  }

  /* ---------- out-of-stock state ---------- */
  .catalog-card.out-of-stock, .card.out-of-stock{
    filter:none; pointer-events:auto;
    border-color:rgba(255,99,99,0.55);
    box-shadow:0 18px 44px -26px rgba(255,99,99,0.42), 0 0 0 1px rgba(255,99,99,0.18) inset;
  }
  .catalog-card.out-of-stock:not(.photo-card) > :not(.out-of-stock-badge),
  .card.out-of-stock > :not(.out-of-stock-badge){
    filter:grayscale(1);
  }
  .catalog-card.photo-card.out-of-stock .photo-bg,
  .catalog-card.photo-card.out-of-stock .pod-float,
  .catalog-card.photo-card.out-of-stock .photo-info > :not(.out-of-stock-strip){
    filter:grayscale(1);
  }
  .catalog-card.out-of-stock .add-cart-btn,
  .card.out-of-stock .add-cart-btn{ pointer-events:none; }
  .catalog-card.out-of-stock{ pointer-events:auto; }
  .catalog-card.out-of-stock .add-cart-btn,
  .card.out-of-stock .add-cart-btn{
    opacity:1; cursor:not-allowed;
    background:rgba(255,255,255,0.07);
    color:#9fb1bf;
    border-color:rgba(255,255,255,0.14);
    box-shadow:none;
  }
  .catalog-card.out-of-stock .price,
  .catalog-card.out-of-stock h4{ color:#eef7fb; }
  .catalog-card.out-of-stock .card-brand,
  .catalog-card.out-of-stock p,
  .catalog-card.out-of-stock .price small{ color:rgba(234,246,251,0.72); }
  .out-of-stock-badge{
    position:absolute; top:14px; right:14px; left:auto; z-index:6;
    display:inline-flex; align-items:center; gap:8px;
    background:linear-gradient(135deg, rgba(255,79,79,0.98), rgba(180,24,24,0.98));
    color:#fff; border:1px solid rgba(255,255,255,0.26);
    border-radius:999px; padding:8px 14px; font-size:0.72rem; font-weight:800;
    letter-spacing:0.08em; text-transform:uppercase;
    box-shadow:0 10px 26px -14px rgba(255,79,79,0.85);
  }
  .out-of-stock-badge::before{
    content:''; width:8px; height:8px; border-radius:999px;
    background:#fff; box-shadow:0 0 0 4px rgba(255,255,255,0.16);
  }
  .catalog-card.photo-card.out-of-stock .photo-bg::after{
    content:''; position:absolute; inset:0; z-index:0;
    background:linear-gradient(180deg, rgba(4,8,14,0.08), rgba(4,8,14,0.18));
    pointer-events:none;
  }
  .catalog-card.photo-card.out-of-stock .pod-float,
  .catalog-card.photo-card.out-of-stock .card-icon.has-photo img{
    filter:drop-shadow(0 18px 24px rgba(0,0,0,0.48));
  }
  .out-of-stock-strip{
    display:inline-flex; align-items:center; gap:8px;
    margin:0 0 12px; padding:8px 12px;
    background:rgba(255,79,79,0.12); border:1px solid rgba(255,99,99,0.34);
    color:#ffd9d9; border-radius:12px; font-size:0.75rem; font-weight:700;
    backdrop-filter:blur(6px);
  }
  .out-of-stock-strip::before{
    content:''; width:8px; height:8px; border-radius:999px; background:#ff6b6b;
    box-shadow:0 0 0 4px rgba(255,107,107,0.14);
  }
  .pm-media.out-of-stock-media{
    filter:none;
    box-shadow:inset 0 0 0 2px rgba(255,99,99,0.18);
  }
  .pm-out-of-stock-note{
    background:rgba(229,72,77,0.12); border:1px solid rgba(229,72,77,0.4); color:#ff8b8f;
    border-radius:12px; padding:10px 14px; font-size:0.84rem; margin-bottom:16px; text-align:center; font-weight:600;
  }

  .catalog-card::before{
    content:''; position:absolute; left:0; right:0; bottom:0; height:64px;
    background-image:var(--wave-footer-img); background-size:cover; background-position:bottom;
    opacity:0.16; z-index:0; pointer-events:none;
    mix-blend-mode:screen;
  }
  .catalog-card::after{
    content:''; position:absolute; top:-16px; right:-16px; width:84px; height:84px;
    background-image:var(--smoke-corner-img); background-size:contain; background-repeat:no-repeat;
    opacity:0.3; z-index:0; pointer-events:none;
  }
  .catalog-card > *{ position:relative; z-index:1; }
  .catalog-card:hover, .catalog-card.touch-active{
    transform:translateY(-12px) rotateX(7deg) rotateY(-7deg) scale(1.035);
    border-color:rgba(72,202,228,0.55);
    box-shadow:0 30px 55px -20px var(--card-glow, rgba(0,180,216,0.55)), 0 0 0 1px rgba(255,255,255,0.03) inset;
    z-index:2;
  }
  .catalog-card .card-icon{ height:110px; margin-bottom:14px; display:flex; align-items:center; justify-content:center; }
  .catalog-card .card-icon svg{ width:64px; height:64px; stroke:var(--card-glow, var(--teal)); filter:drop-shadow(0 0 10px var(--card-glow, var(--teal))); }
  .catalog-card .card-icon.has-photo img{
    width:100%; height:100%; object-fit:cover; border-radius:14px;
    box-shadow:0 0 0 2px var(--card-glow, var(--teal));
  }
  .catalog-card .card-tag{ font-family:'JetBrains Mono', monospace; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--card-glow, var(--teal)); margin-bottom:6px; }
  .catalog-card .card-brand{ color:var(--muted); font-size:0.72rem; margin-bottom:2px; }
  .catalog-card h4{ font-family:'Baloo 2',sans-serif; font-size:1.02rem; font-weight:600; margin-bottom:6px; }
  .catalog-card p{ color:var(--muted); font-size:0.82rem; flex:1; }
  .catalog-card .card-foot{ display:flex; align-items:center; justify-content:space-between; margin-top:14px; padding-top:14px; border-top:1px solid rgba(255,255,255,0.08); }
  .catalog-card .price{ font-family:'JetBrains Mono', monospace; font-weight:600; font-size:0.95rem; }
  .catalog-card .price small{ color:var(--muted); font-weight:400; font-size:.68rem; display:block; }

  /* ---------- photo-card variant: static bg (covers whole card) + floating pod on top ---------- */
  .catalog-card.photo-card{
    padding:0; justify-content:flex-end; min-height:380px;
    background:var(--deep);
  }
  .catalog-card.photo-card::before{ content:none; }
  .catalog-card.photo-card::after{ content:none; }
  .catalog-card.photo-card .photo-bg{
    position:absolute; inset:0; z-index:0;
  }
  .catalog-card.photo-card .photo-bg img{
    width:100%; height:100%; object-fit:cover; display:block;
  }
  .catalog-card.photo-card .pod-float{
    position:absolute; left:50%; top:38%; width:48%; z-index:1;
    transform:translate(-50%,-50%);
    filter:drop-shadow(0 20px 24px rgba(0,0,0,0.5));
    animation:podFloatGentle 4.4s ease-in-out infinite;
  }
  .catalog-card.photo-card .pod-float img{ width:100%; height:auto; display:block; }
  .catalog-card.photo-card .photo-info{
    position:relative; z-index:2;
    padding:56px 20px 22px;
    background:linear-gradient(180deg, transparent, rgba(2,14,26,0.55) 45%, rgba(2,14,26,0.95) 100%);
  }
  .catalog-card.photo-card .card-tag,
  .catalog-card.photo-card .card-brand,
  .catalog-card.photo-card h4{ text-shadow:0 2px 8px rgba(0,0,0,0.5); }
  .catalog-card.photo-card p{ color:rgba(234,246,251,0.75); }
  .catalog-card.photo-card .card-foot{ border-top-color:rgba(255,255,255,0.14); }

  .add-cart-btn{
    display:inline-flex; align-items:center; gap:6px;
    font-family:'Manrope',sans-serif; font-weight:700; font-size:0.72rem;
    padding:9px 13px; border-radius:999px;
    border:1px solid var(--teal); color:var(--teal);
    background:transparent; cursor:pointer; transition:all .25s;
    white-space:nowrap; touch-action:manipulation; flex-shrink:0;
  }
  .add-cart-btn svg{ width:14px; height:14px; stroke:currentColor; }
  .add-cart-btn:hover{ background:var(--teal); color:#031b2e; box-shadow:0 0 16px rgba(0,180,216,0.4); }
  .add-cart-btn.added{
    background:linear-gradient(135deg, var(--teal), var(--seafoam));
    border-color:transparent; color:#031b2e;
  }

  /* ---------- cart bar + drawer ---------- */
  .cart-bar{
    position:fixed; left:50%; bottom:20px; z-index:150;
    transform:translate(-50%, 160%);
    display:flex; align-items:center; gap:16px;
    background:linear-gradient(135deg, var(--panel-2), var(--panel));
    border:1px solid rgba(72,202,228,0.35);
    border-radius:999px; padding:10px 12px 10px 20px;
    box-shadow:0 20px 50px -15px rgba(0,0,0,0.6), 0 0 30px rgba(0,180,216,0.15);
    transition:transform .45s cubic-bezier(.22,.9,.35,1);
    max-width:calc(100% - 32px);
  }
  .cart-bar.visible{ transform:translate(-50%, 0); }
  .cart-bar.pulse{ animation:cartPulse .4s ease; }
  @keyframes cartPulse{ 0%{ transform:translate(-50%,0) scale(1); } 40%{ transform:translate(-50%,0) scale(1.045); } 100%{ transform:translate(-50%,0) scale(1); } }

  .cart-icon-badge{ position:relative; display:flex; align-items:center; justify-content:center; width:30px; height:30px; flex-shrink:0; }
  .cart-icon-badge svg{ width:22px; height:22px; stroke:var(--aqua); }
  .cart-badge{
    position:absolute; top:-6px; right:-8px; min-width:18px; height:18px; padding:0 4px;
    border-radius:999px; background:var(--seafoam); color:#031b2e;
    font-family:'JetBrains Mono',monospace; font-size:0.65rem; font-weight:700;
    display:flex; align-items:center; justify-content:center;
  }
  .cart-bar-total{ display:flex; flex-direction:column; line-height:1.2; white-space:nowrap; }
  .cart-bar-total .label{ font-family:'JetBrains Mono',monospace; font-size:0.62rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); }
  .cart-bar-total .value{ font-family:'Baloo 2',sans-serif; font-weight:700; font-size:1rem; }
  .cart-view-btn{ padding:11px 22px; font-size:0.8rem; }

  .cart-scrim{
    position:fixed; inset:0; z-index:199;
    background:rgba(2,10,18,0.6); backdrop-filter:blur(2px);
    opacity:0; pointer-events:none; transition:opacity .3s;
  }
  .cart-scrim.open{ opacity:1; pointer-events:auto; }

  .cart-drawer{
    position:fixed; left:50%; bottom:0; z-index:200;
    width:min(94vw, 480px); max-height:80vh;
    transform:translate(-50%, 100%);
    background:linear-gradient(180deg, #06263e, #031b2e);
    border:1px solid var(--line); border-bottom:none;
    border-radius:26px 26px 0 0;
    display:flex; flex-direction:column;
    box-shadow:0 -20px 60px -20px rgba(0,0,0,0.7);
    transition:transform .4s cubic-bezier(.22,.9,.35,1);
  }
  .cart-drawer.open{ transform:translate(-50%, 0); }

  .cart-drawer-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:22px 22px 16px; border-bottom:1px solid var(--line); flex-shrink:0;
  }
  .cart-drawer-head h3{ font-size:1.15rem; font-weight:700; }
  .cart-close{
    width:34px; height:34px; border-radius:50%;
    border:1px solid var(--line); background:transparent; color:var(--ink);
    cursor:pointer; font-size:1rem; touch-action:manipulation;
  }
  .cart-close:hover{ border-color:rgba(72,202,228,0.5); color:var(--aqua); }

  .cart-items{ flex:1; overflow-y:auto; padding:16px 22px; display:flex; flex-direction:column; gap:16px; min-height:0; }
  .cart-empty{ text-align:center; color:var(--muted); padding:36px 0; font-size:0.9rem; }

  .cart-item{ display:flex; align-items:center; gap:12px; }
  .cart-item-icon{
    width:46px; height:46px; border-radius:12px; flex-shrink:0;
    background:var(--panel); border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
  }
  .cart-item-icon svg{ width:24px; height:24px; stroke:var(--card-glow, var(--teal)); }
  .cart-item-icon.has-photo{ padding:0; overflow:hidden; background:none; border-color:var(--card-glow, var(--teal)); }
  .cart-item-icon.has-photo img{ width:100%; height:100%; object-fit:contain; }
  .cart-item-info{ flex:1; min-width:0; }
  .cart-item-info .name{ font-weight:600; font-size:0.86rem; }
  .cart-item-info .unit{ color:var(--muted); font-size:0.72rem; margin-top:2px; }
  .cart-item-qty{ display:flex; align-items:center; gap:8px; flex-shrink:0; }
  .qty-btn{
    width:26px; height:26px; border-radius:50%;
    border:1px solid var(--line); background:var(--deep); color:var(--ink);
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    font-size:0.95rem; line-height:1; touch-action:manipulation;
  }
  .qty-btn:hover{ border-color:rgba(72,202,228,0.5); }
  .cart-item-qty .qty-num{ font-family:'JetBrains Mono',monospace; font-size:0.85rem; min-width:16px; text-align:center; }
  .cart-item-remove{
    background:none; border:none; color:var(--muted); cursor:pointer;
    font-size:0.7rem; text-decoration:underline; flex-shrink:0; touch-action:manipulation;
  }
  .cart-item-remove:hover{ color:var(--ink); }

  .cart-drawer-foot{
    padding:18px 22px calc(24px + env(safe-area-inset-bottom, 0px));
    border-top:1px solid var(--line); flex-shrink:0;
    display:flex; flex-direction:column; gap:14px;
  }
  .cart-total-row{
    display:flex; align-items:center; justify-content:space-between;
    font-family:'Baloo 2',sans-serif; font-size:1.15rem; font-weight:700;
  }
  .cart-total-row span:last-child{ color:var(--aqua); }
  #cartCheckoutBtn.disabled{ opacity:0.4; pointer-events:none; box-shadow:none; }

  /* ---------- product detail modal ---------- */
  .product-modal{ position:fixed; inset:0; z-index:300; display:flex; align-items:center; justify-content:center; padding:24px; }
  .product-modal[hidden]{ display:none; }
  .product-modal-scrim{ position:absolute; inset:0; background:rgba(2,10,18,0.78); backdrop-filter:blur(6px); animation:pmFadeIn .3s ease; }
  .product-modal-panel{
    position:relative; z-index:1; width:100%; max-width:920px; max-height:88vh; overflow-y:auto;
    background:linear-gradient(160deg, var(--panel-2), var(--panel));
    border:1px solid var(--line); border-radius:26px;
    display:grid; grid-template-columns:1fr 1fr; gap:36px;
    padding:32px; box-shadow:0 40px 90px -20px rgba(0,0,0,0.6);
    animation:pmSlideUp .35s cubic-bezier(.22,.9,.35,1);
  }
  @keyframes pmFadeIn{ from{ opacity:0; } to{ opacity:1; } }
  @keyframes pmSlideUp{ from{ opacity:0; transform:translateY(24px) scale(.98); } to{ opacity:1; transform:translateY(0) scale(1); } }
  .product-modal-close{
    position:absolute; top:16px; right:16px; z-index:2;
    width:38px; height:38px; border-radius:50%; border:1px solid var(--line);
    background:rgba(3,20,35,0.6); color:var(--ink); display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition:background .2s, transform .2s;
  }
  .product-modal-close:hover{ background:rgba(255,255,255,0.08); transform:rotate(90deg); }
  .product-modal-close svg{ width:18px; height:18px; }

  .pm-media{
    position:relative; border-radius:20px; overflow:hidden; min-height:340px;
    background:linear-gradient(160deg, var(--panel), var(--deep));
    display:flex; align-items:center; justify-content:center;
  }
  .pm-media .pm-bg{ position:absolute; inset:0; }
  .pm-media .pm-bg img{ width:100%; height:100%; object-fit:cover; object-position:center; display:block; }
  .pm-media .pm-pod{ position:relative; z-index:1; width:56%; filter:drop-shadow(0 20px 24px rgba(0,0,0,0.5)); animation:pmPodFloat 4.4s ease-in-out infinite; }
  .pm-media .pm-pod img{ width:100%; height:auto; display:block; }
  @keyframes pmPodFloat{
    0%, 100%{ transform:translateY(0) rotate(-1.2deg); }
    50%{ transform:translateY(-12px) rotate(1.2deg); }
  }
  .pm-media .pm-icon{ position:relative; width:140px; height:140px; }
  .pm-media .pm-icon svg{ width:100%; height:100%; stroke:var(--card-glow, var(--teal)); filter:drop-shadow(0 0 22px var(--card-glow, var(--teal))); }
  .pm-media .pm-icon img{ width:100%; height:100%; object-fit:contain; filter:drop-shadow(0 10px 16px rgba(0,0,0,0.45)) drop-shadow(0 0 16px var(--card-glow, var(--teal))); }

  .pm-info{ display:flex; flex-direction:column; }
  .pm-tag{ font-family:'JetBrains Mono', monospace; font-size:0.7rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--card-glow, var(--teal)); margin-bottom:8px; }
  .pm-info h2{ font-family:'Baloo 2',sans-serif; font-size:1.5rem; font-weight:700; margin-bottom:10px; line-height:1.15; }
  .pm-price{ font-family:'JetBrains Mono', monospace; font-size:1.5rem; font-weight:700; color:var(--card-glow, var(--aqua)); margin-bottom:22px; }

  .pm-qty-row{ display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
  .pm-qty-label{ color:var(--muted); font-size:0.88rem; }
  .pm-qty-stepper{ display:flex; align-items:center; gap:14px; border:1px solid var(--line); border-radius:999px; padding:6px 8px; }
  .pm-qty-stepper button{
    width:28px; height:28px; border-radius:50%; border:1px solid var(--line); background:transparent; color:var(--ink);
    font-size:1.05rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background .2s;
  }
  .pm-qty-stepper button:hover{ background:rgba(255,255,255,0.08); }
  .pm-qty-stepper span{ min-width:20px; text-align:center; font-family:'JetBrains Mono', monospace; font-weight:600; }

  .pm-actions{ display:flex; gap:12px; margin-bottom:24px; }
  .pm-btn{
    flex:1; padding:13px 18px; border-radius:999px; font-weight:600; font-size:0.9rem;
    cursor:pointer; transition:transform .2s, background .2s, opacity .2s; text-align:center;
  }
  .pm-btn:active{ transform:scale(0.97); }
  .pm-btn-outline{ background:rgba(255,255,255,0.05); border:1px solid var(--line); color:var(--ink); }
  .pm-btn-outline:hover{ background:rgba(255,255,255,0.1); }
  .pm-btn-solid{ background:var(--foam); border:1px solid var(--foam); color:#04263a; }
  .pm-btn-solid:hover{ opacity:0.9; }
  .pm-btn.added{ background:var(--seafoam); border-color:var(--seafoam); color:#04263a; }

  .pm-divider{ height:1px; background:var(--line); margin-bottom:20px; }
  .pm-desc-label{ font-weight:600; margin-bottom:8px; color:var(--ink); }
  .pm-desc{ color:var(--muted); font-size:0.92rem; line-height:1.6; margin-bottom:22px; }

  .pm-whatsapp{
    display:flex; align-items:center; justify-content:center; gap:8px;
    margin-top:auto; padding:12px; border-radius:999px; border:1px solid var(--line);
    color:var(--muted); font-size:0.86rem; transition:color .2s, border-color .2s;
  }
  .pm-whatsapp:hover{ color:#25D366; border-color:#25D366; }
  .pm-whatsapp svg{ width:18px; height:18px; }

  @media (max-width:720px){
    .product-modal{ padding:0; align-items:flex-end; }
    .product-modal-panel{ grid-template-columns:1fr; max-height:92vh; border-radius:22px 22px 0 0; padding:22px; gap:20px; }
    .pm-media{ min-height:260px; }
  }

  /* ---------- whatsapp floating button ---------- */
  .whatsapp-float{
    position:fixed; right:18px; bottom:18px; z-index:160;
    width:58px; height:58px; border-radius:50%;
    background:#25d366; color:#fff;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 10px 30px -8px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.06);
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .whatsapp-float svg{ width:30px; height:30px; position:relative; z-index:1; }
  .whatsapp-float:hover{ transform:scale(1.08); box-shadow:0 14px 36px -8px rgba(0,0,0,0.6); }
  .whatsapp-float:active{ transform:scale(0.96); }

  .whatsapp-ring{
    position:absolute; inset:0; border-radius:50%;
    background:#25d366; opacity:0.55;
    animation:whatsappPulse 2.4s ease-out infinite;
  }
  @keyframes whatsappPulse{
    0%{ transform:scale(1); opacity:0.5; }
    100%{ transform:scale(1.9); opacity:0; }
  }

  @media (max-width:640px){
    .whatsapp-float{ width:52px; height:52px; right:14px; bottom:14px; }
    .whatsapp-float svg{ width:26px; height:26px; }
  }

  .catalog-card.hide{ display:none; }
  .catalog-empty{ text-align:center; color:var(--muted); padding:40px 0; }

  @media (max-width:640px){
    .catalog-card:hover, .catalog-card.touch-active{ transform:translateY(-8px) rotateX(4deg) rotateY(-4deg) scale(1.02); }
  }

  .arrow{
    width:46px; height:46px; border-radius:50%; border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center; cursor:pointer; background:var(--deep);
    transition:all .25s; touch-action:manipulation;
  }
  .arrow:hover, .arrow:focus-visible{ border-color:var(--teal); box-shadow:0 0 20px rgba(0,180,216,0.4); }
  .arrow svg{ width:18px; height:18px; stroke:var(--ink); }

  /* ---------- stats ---------- */
  .stats{
    display:grid; grid-template-columns:repeat(4,1fr); gap:24px;
    max-width:1100px; margin:0 auto; padding:50px clamp(20px,5vw,64px) 90px;
    position:relative; z-index:1; background:var(--deep);
  }
  .stat{ text-align:center; }
  .stat .num{
    font-family:'Baloo 2', sans-serif; font-weight:800; font-size:clamp(1.8rem,3.4vw,2.6rem);
    background:linear-gradient(90deg, var(--teal), var(--seafoam));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .stat .label{ color:var(--muted); font-size:0.82rem; margin-top:6px; }

  /* ---------- sobre ---------- */
  .sobre{ background:var(--panel); }
  .sobre-inner{ display:grid; grid-template-columns:0.9fr 1.1fr; gap:64px; align-items:center; max-width:1200px; margin:0 auto; }
  .sobre-visual{
    position:relative; border-radius:28px; overflow:hidden; aspect-ratio:4/5;
    background:linear-gradient(160deg, var(--panel-2), var(--panel));
    border:1px solid var(--line); display:flex; align-items:center; justify-content:center;
  }
  .sobre-visual::before{
    content:''; position:absolute; inset:0;
    background:radial-gradient(circle at 30% 20%, rgba(0,180,216,0.3), transparent 45%), radial-gradient(circle at 80% 80%, rgba(46,196,182,0.28), transparent 45%);
  }
  .sobre-visual::before{ z-index:0; pointer-events:none; }
  .sobre-store-img{
    position:relative; z-index:1; width:100%; height:100%; display:block;
    object-fit:cover; object-position:center; border-radius:27px;
  }
  .sobre h2{ font-size:clamp(1.8rem,3.6vw,2.6rem); font-weight:700; margin-bottom:20px; }
  .sobre-inner > div > p{ color:var(--muted); font-size:1.02rem; margin-bottom:36px; max-width:56ch; }
  .steps{ display:flex; flex-direction:column; gap:22px; }
  .step{ display:flex; gap:18px; align-items:flex-start; }
  .step-num{
    font-family:'JetBrains Mono', monospace; color:var(--teal); font-size:0.85rem;
    border:1px solid rgba(0,180,216,0.4); border-radius:50%; width:34px; height:34px;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .step h4{ font-size:1rem; font-weight:700; margin-bottom:4px; font-family:'Baloo 2',sans-serif; }
  .step p{ color:var(--muted); font-size:0.88rem; }

  /* ---------- depoimentos ---------- */
  .depoimentos{ background:var(--deep); }
  .depo-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; max-width:1180px; margin:0 auto; }
  .depo{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
    padding:30px; display:flex; flex-direction:column; gap:18px;
    transition:transform .3s, border-color .3s;
  }
  .depo:hover{ transform:translateY(-6px); border-color:rgba(46,196,182,0.5); }
  .depo .stars{ color:var(--seafoam); letter-spacing:2px; }
  .depo p{ color:#cfe9f5; font-size:0.94rem; line-height:1.6; flex:1; }
  .depo-who{ display:flex; align-items:center; gap:12px; }
  .depo-avatar{
    width:38px; height:38px; border-radius:50%;
    background:linear-gradient(135deg, var(--teal), var(--seafoam));
    display:flex; align-items:center; justify-content:center;
    font-family:'Baloo 2',sans-serif; font-weight:700; font-size:0.8rem; color:#031b2e;
  }
  .depo-who .name{ font-weight:700; font-size:0.86rem; }
  .depo-who .role{ color:var(--muted); font-size:0.76rem; }

  /* ---------- contato ---------- */
  .contato{
    text-align:center; background:var(--panel);
    background-image:radial-gradient(ellipse 60% 70% at 50% 100%, rgba(46,196,182,0.14), transparent), radial-gradient(ellipse 50% 50% at 20% 0%, rgba(0,180,216,0.12), transparent);
  }
  .contato h2{ font-size:clamp(2rem,5vw,3.2rem); font-weight:800; max-width:18ch; margin:0 auto 20px; }
  .contato p{ color:var(--muted); max-width:50ch; margin:0 auto 40px; }

  /* ---------- footer ---------- */
  .footer-wrap{ position:relative; background:linear-gradient(180deg, #031627, #020d18); }
  footer{
    position:relative; z-index:1;
    padding:50px clamp(20px,5vw,64px) 36px;
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;
    font-size:0.82rem; color:var(--muted);
  }
  footer .foot-links{ display:flex; gap:22px; flex-wrap:wrap; }
  footer a:hover{ color:var(--aqua); }

  /* ---------- responsive ---------- */
  @media (max-width:900px){
    .sobre-inner{ grid-template-columns:1fr; }
    .header-mobile-actions{ display:flex; }
    .depo-grid{ grid-template-columns:1fr; }
    .stats{ grid-template-columns:repeat(2,1fr); }
    nav ul{ display:none; }
    .nav-links > a.btn{ display:none; }
    .menu-toggle{ display:flex; }
    .auth-trigger-icon{ display:flex; }
  }
  @media (max-width:640px){
    section{ padding:80px 18px; }
    .hero{ padding:130px 16px 70px; }
    .hero-banner{ height:auto; aspect-ratio:16 / 9; border-radius:20px; }
    .hero-slide{ padding:30px 20px; }
    .hero-arrow{ width:38px; height:38px; }
    .hero-arrow.prev{ left:8px; }
    .hero-arrow.next{ right:8px; }
    .stage{ height:440px; }
    .ring{ width:230px; height:330px; }
    .stats{ grid-template-columns:repeat(2,1fr); padding-bottom:70px; }
    header{ padding:14px 18px; }
    .card{ padding:20px; }
  }


  /* V18: mobile — banner sem faixas pretas e divisores de água estáveis */
  @media (max-width:640px){
    html,body{ width:100%; max-width:100%; overflow-x:hidden; background:#031b2e; }
    main{ overflow:hidden; }
    .hero{
      min-height:auto !important;
      padding:112px 0 0 !important;
      justify-content:flex-start;
      overflow:hidden;
    }
    .hero-banner{
      width:calc(100% - 28px);
      margin:0 auto;
      aspect-ratio:16/9;
      min-height:0;
      border-radius:18px;
      background:var(--panel) !important;
    }
    .hero-slide{ padding:0 !important; inset:0; overflow:hidden; }
    .hero-slide img{
      width:100% !important;
      height:100% !important;
      object-fit:cover !important;
      object-position:center !important;
      background:transparent !important;
    }
    .hero-arrow{ width:38px; height:38px; }
    .hero-dots{ bottom:10px; }
    .illustrated-wave{
      position:relative !important;
      left:auto !important; right:auto !important; bottom:auto !important;
      width:100vw !important;
      height:74px !important;
      margin:18px 0 -1px calc(50% - 50vw) !important;
      overflow:hidden !important;
      background-image:var(--wave-footer-img);
      background-repeat:no-repeat;
      background-size:cover;
      background-position:center bottom;
      opacity:.92;
    }
    .illustrated-wave img{ display:none !important; }
    .wave-strip{ height:58px !important; margin:-1px 0; }
    .wave-strip img{ object-fit:cover !important; object-position:center !important; transform:scale(1.03); }
    .wave-strip.flip img{ transform:scale(1.03,-1.03); }
    .footer-wave{ height:86px !important; margin-bottom:-28px !important; overflow:hidden !important; }
    .footer-wave img{ object-fit:cover !important; object-position:center bottom !important; }
    section:not(.hero){ padding-left:18px; padding-right:18px; }
    .vitrine{ padding-top:68px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; }
  }

  :focus-visible{ outline:2px solid var(--teal); outline-offset:3px; }

  /* Admin: preços e promoções */
  .admin-product-manager{display:grid;gap:12px}
  .admin-product-row{border:1px solid rgba(255,255,255,.10);background:rgba(255,255,255,.035);border-radius:16px;padding:14px;display:grid;gap:12px}
  .admin-product-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
  .admin-product-name{font-weight:800;color:var(--ink);font-size:.94rem}
  .admin-product-meta{font-size:.72rem;color:var(--muted);margin-top:3px}
  .admin-product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
  .admin-product-field{display:grid;gap:5px}
  .admin-product-field span{font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800}
  .admin-product-field input{width:100%;border:1px solid rgba(255,255,255,.13);background:rgba(2,21,34,.68);color:var(--ink);border-radius:10px;padding:9px 10px;outline:none}
  .admin-product-field input:focus{border-color:var(--aqua)}
  .admin-product-actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
  .admin-promo-check{display:flex;align-items:center;gap:7px;color:var(--ink);font-size:.78rem;font-weight:700}
  .admin-promo-check input{accent-color:#19c9d2;width:17px;height:17px}
  .admin-product-save{border:0;border-radius:10px;padding:9px 13px;font-weight:800;cursor:pointer;background:linear-gradient(90deg,#13b9d0,#36d0bd);color:#032033}
  .admin-product-save:disabled{opacity:.5;cursor:wait}
  .admin-stock-inline{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:.72rem;color:var(--muted)}
  .promo-badge{position:absolute;z-index:8;top:12px;left:12px;background:#ff476f;color:white;font-size:.66rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;border-radius:999px;padding:6px 9px;box-shadow:0 8px 20px rgba(255,71,111,.28)}
  /* Promoção: não alterar o position:absolute dos cards do carrossel */
  .catalog-card.promo-active{position:relative}
  .card.promo-active{position:absolute}
  .price .old-price,.pm-price .old-price{display:block;color:#9db2c2;text-decoration:line-through;font-size:.72em;font-weight:600;line-height:1.15}
  .price .current-price,.pm-price .current-price{display:block;color:inherit;font-size:1em;font-weight:900;line-height:1.15}
  .pm-price.promo-price{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
  .pm-price.promo-price .old-price,.pm-price.promo-price .current-price{display:inline-block}
  @media(max-width:760px){.admin-product-grid{grid-template-columns:1fr}.admin-stock-inline{margin-left:0}}


  /* ---------- V22: IGNITE V400 MIX cards (catalog only) ---------- */
  /* IGNITE V400 MIX — mesmo padrão dos cards fotográficos antigos:
     fundo cobre o card inteiro e permanece estático; apenas a região do pod flutua. */
  .catalog-card.composite-card{
    padding:0; justify-content:flex-end; min-height:380px; overflow:hidden; background:var(--deep);
  }
  .catalog-card.composite-card::before,
  .catalog-card.composite-card::after{ content:none; }

  /* O card em si não inclina/anda: o movimento fica somente no pod. */
  .catalog-card.composite-card:hover,
  .catalog-card.composite-card.touch-active{
    transform:none !important;
  }

  /* imagem criada ocupa TODO o card, sem corte por bloco superior */
  .catalog-card.composite-card .composite-media{
    position:absolute; inset:0; z-index:0; overflow:hidden; background:#071523;
  }
  .catalog-card.composite-card .composite-media > img.composite-bg{
    width:100%; height:100%; object-fit:cover; object-position:center center; display:block;
    transform:none !important; animation:none !important;
    filter:saturate(1.03) contrast(1.02);
  }

  /* Segunda cópia da mesma arte, mascarada somente no centro.
     Ela cria a flutuação visual do pod sem movimentar o fundo inteiro. */
  .catalog-card.composite-card .composite-pod-motion{
    position:absolute; inset:0; z-index:1; pointer-events:none; overflow:hidden;
    -webkit-mask-image:radial-gradient(ellipse 31% 43% at 52% 39%, #000 0 62%, rgba(0,0,0,.92) 72%, transparent 100%);
            mask-image:radial-gradient(ellipse 31% 43% at 52% 39%, #000 0 62%, rgba(0,0,0,.92) 72%, transparent 100%);
    animation:ignitePodOnlyFloat 4.4s ease-in-out infinite;
    transform-origin:52% 39%;
  }
  .catalog-card.composite-card .composite-pod-motion img{
    width:100%; height:100%; object-fit:cover; object-position:center center; display:block;
    filter:saturate(1.03) contrast(1.02) drop-shadow(0 16px 20px rgba(0,0,0,.12));
  }
  @keyframes ignitePodOnlyFloat{
    0%,100%{ transform:translateY(0) rotate(-.12deg) scale(1.002); }
    50%{ transform:translateY(-7px) rotate(.12deg) scale(1.006); }
  }

  /* Informações ficam sobre a própria imagem, igual aos cards antigos */
  .catalog-card.composite-card .composite-info{
    position:relative; z-index:3; width:100%;
    padding:76px 20px 22px;
    background:linear-gradient(180deg, transparent 0%, rgba(2,14,26,.18) 18%, rgba(2,14,26,.70) 48%, rgba(2,14,26,.96) 100%);
  }
  .catalog-card.composite-card .card-tag,
  .catalog-card.composite-card .card-brand,
  .catalog-card.composite-card h4{ text-shadow:0 2px 8px rgba(0,0,0,.62); }
  .catalog-card.composite-card .card-brand{ margin-bottom:5px; }
  .catalog-card.composite-card h4{ min-height:48px; line-height:1.18; margin-bottom:8px; }
  .catalog-card.composite-card .card-foot{ margin-top:10px; border-top-color:rgba(255,255,255,.14); }

  @media (max-width:640px){
    .catalog-card.composite-card{ min-height:380px; }
    .catalog-card.composite-card .composite-info{ padding:68px 18px 20px; }
    .catalog-card.composite-card h4{ min-height:auto; }
    .catalog-card.composite-card .composite-pod-motion{
      -webkit-mask-image:radial-gradient(ellipse 34% 42% at 52% 38%, #000 0 60%, rgba(0,0,0,.90) 73%, transparent 100%);
              mask-image:radial-gradient(ellipse 34% 42% at 52% 38%, #000 0 60%, rgba(0,0,0,.90) 73%, transparent 100%);
    }
  }

  /* ---------- V24: card em camadas reais (fundo parado + pod solto) ---------- */
  .catalog-card.composite-card.layered-pod-card .composite-media{
    position:absolute; inset:0; overflow:hidden; z-index:0;
  }
  .catalog-card.composite-card.layered-pod-card .composite-bg{
    position:absolute; inset:0;
    width:100%; height:100%;
    object-fit:cover; object-position:center center;
    display:block;
    transform:none !important;
    animation:none !important;
    filter:saturate(1.03) contrast(1.03);
  }
  .catalog-card.composite-card.layered-pod-card .composite-pod-motion{
    position:absolute;
    left:50%; top:39%;
    width:47%; height:auto;
    inset:auto;
    overflow:visible;
    z-index:2;
    pointer-events:none;
    -webkit-mask-image:none;
            mask-image:none;
    transform:translate(-50%,-50%);
    transform-origin:50% 50%;
    animation:igniteV24PodFloat 4.2s ease-in-out infinite;
    filter:drop-shadow(0 18px 24px rgba(0,0,0,.48));
  }
  .catalog-card.composite-card.layered-pod-card .composite-pod-motion img{
    width:100%; height:auto;
    object-fit:contain;
    display:block;
    filter:none;
  }
  @keyframes igniteV24PodFloat{
    0%,100%{ transform:translate(-50%,-50%) translateY(0) rotate(-1.1deg); }
    50%{ transform:translate(-50%,-50%) translateY(-11px) rotate(1.1deg); }
  }
  .catalog-card.composite-card.layered-pod-card:hover,
  .catalog-card.composite-card.layered-pod-card.touch-active{
    transform:none !important;
  }
  .catalog-card.composite-card.layered-pod-card .composite-info{
    z-index:4;
  }
  @media (max-width:640px){
    .catalog-card.composite-card.layered-pod-card .composite-pod-motion{
      width:49%;
      top:38%;
      -webkit-mask-image:none;
              mask-image:none;
    }
  }


/* ---------- V25: IGNITE V400 MIX — POD RETO E CENTRALIZADO ---------- */
.catalog-card.composite-card.layered-pod-card .composite-media{
  position:absolute !important;
  inset:0 !important;
  overflow:hidden !important;
}

.catalog-card.composite-card.layered-pod-card .composite-bg{
  position:absolute !important;
  inset:0 !important;
  width:100% !important;
  height:100% !important;
  object-fit:cover !important;
  object-position:center center !important;
  transform:none !important;
  animation:none !important;
}

/* Camada independente somente do pod */
.catalog-card.composite-card.layered-pod-card .composite-pod-motion{
  position:absolute !important;
  left:50% !important;
  top:38% !important;
  width:39% !important;
  height:auto !important;
  inset:auto !important;
  z-index:3 !important;
  overflow:visible !important;
  pointer-events:none !important;
  transform:translate(-50%,-50%) !important;
  transform-origin:50% 50% !important;
  animation:igniteV25PodFloat 3.8s ease-in-out infinite !important;
  filter:drop-shadow(0 14px 18px rgba(0,0,0,.48)) !important;
  -webkit-mask-image:none !important;
  mask-image:none !important;
}

.catalog-card.composite-card.layered-pod-card .composite-pod-motion img{
  display:block !important;
  width:100% !important;
  height:auto !important;
  max-height:none !important;
  object-fit:contain !important;
  object-position:center center !important;
  transform:none !important;
  rotate:0deg !important;
  animation:none !important;
  filter:none !important;
}

/* SEM rotação: somente sobe e desce */
@keyframes igniteV25PodFloat{
  0%,100%{
    transform:translate(-50%,-50%) translateY(0) !important;
  }
  50%{
    transform:translate(-50%,-50%) translateY(-10px) !important;
  }
}

/* Evita qualquer inclinação do card inteiro */
.catalog-card.composite-card.layered-pod-card,
.catalog-card.composite-card.layered-pod-card:hover,
.catalog-card.composite-card.layered-pod-card.touch-active{
  transform:none !important;
}

/* O texto fica à frente sem interferir no pod */
.catalog-card.composite-card.layered-pod-card .composite-info{
  position:absolute !important;
  left:0 !important;
  right:0 !important;
  bottom:0 !important;
  z-index:5 !important;
}

/* Mobile */
@media (max-width:640px){
  .catalog-card.composite-card.layered-pod-card .composite-pod-motion{
    width:42% !important;
    top:37% !important;
  }
}

</style>
</head>
<body>


<header>
  <a href="#" class="logo" aria-label="Página inicial">
    <img src="assets/embedded/a61812761c75a7a8.png" alt="Puffpod">
  </a>
  <div class="nav-links">
    <nav>
      <ul>
        <li><a href="#vitrine">Vitrine</a></li>
        <li><a href="#sobre">Sobre</a></li>
        <li><a href="#depoimentos">Depoimentos</a></li>
      </ul>
    </nav>
    <a href="#contato" class="btn">Fale Conosco</a>
    <button class="auth-trigger admin-trigger" id="adminTrigger" type="button" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-4z"/></svg>
      <span>Admin</span>
    </button>
  </div>
  <div class="desktop-account-area">
    <button class="auth-trigger" id="authTrigger" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c1.6-3.6 4.6-5.4 7.5-5.4s5.9 1.8 7.5 5.4"/></svg>
      <span>Entrar</span>
    </button>
  </div>
  <div class="header-mobile-actions">
    <button class="auth-trigger-icon" id="authTriggerMobile" type="button" aria-label="Entrar ou cadastrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
      <span>Login</span>
    </button>
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="account-menu" id="accountMenu" hidden>
  <div class="account-menu-head">
    <strong id="accountMenuName">Minha conta</strong>
    <span id="accountMenuEmail"></span>
  </div>
  <button type="button" class="account-menu-btn" id="accountCartBtn">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M3 4h2l2.2 10.4a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 8H6"/></svg>
    <span>Meu carrinho</span>
  </button>
  <button type="button" class="account-menu-btn" id="accountOrdersBtn">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg>
    <span>Minhas compras</span>
  </button>
  <button type="button" class="account-menu-btn" id="accountCashbackBtn">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5c-.7-.8-1.8-1.2-3-1.2-1.7 0-3 .8-3 2s1 1.8 3 2.2 3 1 3 2.3-1.3 2.2-3 2.2c-1.5 0-2.7-.5-3.5-1.4M12 5.5v13"/></svg>
    <span>Ganhos em Cashback</span>
  </button>
  <button type="button" class="account-menu-btn" id="accountReferralBtn" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"/></svg>
    <span>Ganhos com indicação</span>
  </button>
  <button type="button" class="account-menu-btn logout" id="accountLogoutBtn">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h5"/><path d="M14 8l4 4-4 4M18 12H8"/></svg>
    <span>Sair</span>
  </button>
</div>

<div class="account-detail-modal" id="accountDetailModal" hidden>
  <div class="account-detail-scrim" id="accountDetailScrim"></div>
  <div class="account-detail-panel" role="dialog" aria-modal="true" aria-labelledby="accountDetailTitle">
    <button type="button" class="account-detail-close" id="accountDetailClose" aria-label="Fechar">✕</button>
    <h3 id="accountDetailTitle">Minha conta</h3>
    <div class="account-detail-sub" id="accountDetailSub"></div>
    <div id="accountDetailBody"></div>
  </div>
</div>

<div class="scrim" id="scrim"></div>
<nav class="mobile-panel" id="mobilePanel">
  <a href="#vitrine" data-close>Vitrine</a>
  <a href="#sobre" data-close>Sobre</a>
  <a href="#depoimentos" data-close>Depoimentos</a>
  <a href="#contato" class="btn solid" data-close>Fale Conosco</a>
</nav>

<div class="auth-modal" id="authModal" hidden>
  <div class="auth-modal-scrim" id="authModalScrim"></div>
  <div class="auth-modal-panel" role="dialog" aria-modal="true" aria-labelledby="authTitle">
    <button class="product-modal-close" id="authModalClose" type="button" aria-label="Fechar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="auth-head">
      <h2 id="authTitle">Entrar na sua conta</h2>
      <p id="authSubtitle">Acesse para acompanhar pedidos e aproveitar promoções de cashback.</p>
    </div>

    <button type="button" class="auth-google-btn" id="authGoogleBtn">
      <svg viewBox="0 0 48 48" width="20" height="20"><path fill="#EA4335" d="M24 9.5c3.4 0 6.4 1.2 8.8 3.5l6.6-6.6C35.3 2.6 30 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.7 6C12.1 13 17.5 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.6c-.5 3-2.2 5.5-4.7 7.2l7.3 5.7C43.5 37.9 46.5 31.8 46.5 24.5z"/><path fill="#FBBC05" d="M10.3 19.2c-.5 1.5-.8 3.1-.8 4.8s.3 3.3.8 4.8l-7.7 6C1 31.6 0 27.9 0 24s1-7.6 2.6-10.8l7.7 6z"/><path fill="#34A853" d="M24 48c6 0 11.3-2 15-5.4l-7.3-5.7c-2 1.4-4.6 2.2-7.7 2.2-6.5 0-11.9-3.5-13.8-8.7l-7.7 6C6.5 42.6 14.6 48 24 48z"/></svg>
      <span>Continuar com Google</span>
    </button>

    <div class="auth-divider"><span>ou</span></div>

    <p class="auth-note" id="authNote" hidden></p>

    <form id="loginForm" class="auth-form">
      <div class="field">
        <span>E-mail</span>
