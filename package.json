  let heartbeatTimer = null;

  function startHeartbeat(uid){
    stopHeartbeat();
    const beat = () => {
      db.collection('users').doc(uid).update({
        lastSeen: firebase.firestore.FieldValue.serverTimestamp()
      }).catch(() => {});
    };
    beat();
    heartbeatTimer = setInterval(beat, 2 * 60 * 1000);
  }
  function stopHeartbeat(){
    if(heartbeatTimer){ clearInterval(heartbeatTimer); heartbeatTimer = null; }
  }

  function showNote(msg, isError){
    note.textContent = msg;
    note.style.color = isError === false ? 'var(--seafoam)' : 'var(--aqua)';
    note.hidden = false;
  }
  function hideNote(){ note.hidden = true; }

  function friendlyError(err){
    const map = {
      'auth/user-not-found': 'E-mail ou senha incorretos.',
      'auth/wrong-password': 'E-mail ou senha incorretos.',
      'auth/invalid-credential': 'E-mail ou senha incorretos.',
      'auth/email-already-in-use': 'Esse e-mail já tem cadastro. Tente entrar.',
      'auth/weak-password': 'A senha precisa ter pelo menos 6 caracteres.',
      'auth/invalid-email': 'Digite um e-mail válido.',
      'auth/popup-closed-by-user': 'A janela do Google foi fechada antes de concluir o login.',
      'auth/cancelled-popup-request': 'O login anterior foi cancelado. Clique novamente para tentar.',
      'auth/popup-blocked': 'O navegador bloqueou a janela do Google. Libere pop-ups para este site e tente novamente.',
      'auth/unauthorized-domain': 'Este domínio ainda não está autorizado no Firebase. Adicione puffpod.com.br em Authentication → Settings → Authorized domains.',
      'auth/operation-not-allowed': 'O login com Google ainda não está habilitado no Firebase Authentication.'
    };
    if(err.code in map) return map[err.code];
    return 'Não foi possível concluir agora. Tente novamente em instantes.';
  }

  function openModal(){ modal.hidden = false; document.body.style.overflow = 'hidden'; }
  function closeModal(){ modal.hidden = true; document.body.style.overflow = ''; }

  function showLogin(){
    title.textContent = 'Entrar na sua conta';
    subtitle.textContent = 'Acesse para acompanhar pedidos e aproveitar promoções de cashback.';
    loginForm.hidden = false; signupForm.hidden = true;
    switchToSignup.hidden = false; switchToLogin.hidden = true;
    hideNote();
  }
  function showSignup(){
    title.textContent = 'Criar minha conta';
    subtitle.textContent = 'Cadastre-se para guardar seus pedidos e acumular cashback.';
    loginForm.hidden = true; signupForm.hidden = false;
    switchToSignup.hidden = true; switchToLogin.hidden = false;
    if(signupReferral && storedReferralCode()) signupReferral.value = storedReferralCode();
    hideNote();
  }

  function normalizeReferralCode(value){
    return String(value || '').trim().toUpperCase().replace(/[^A-Z0-9_-]/g,'').slice(0,40);
  }
  const authQuery = new URLSearchParams(location.search);
  const incomingReferral = normalizeReferralCode(authQuery.get('ref'));
  const signupRequested = authQuery.get('signup') === '1' || !!incomingReferral;
  if(incomingReferral){
    try{ localStorage.setItem('puffpod_referral_code', incomingReferral); }catch(e){}
  }
  function storedReferralCode(){
    try{return normalizeReferralCode(localStorage.getItem('puffpod_referral_code') || '');}catch(e){return '';}
  }
  async function resolveReferral(code, newUserUid){
    code = normalizeReferralCode(code);
    if(!code) return null;
    const qs = await db.collection('users').where('referralCode','==',code).limit(1).get();
    if(qs.empty) return null;
    const doc = qs.docs[0], d = doc.data() || {};
    if(!d.referralEnabled || (newUserUid && doc.id === newUserUid)) return null;
    return { uid:doc.id, code, name:d.name || '', email:d.email || '' };
  }

  async function ensureUserDoc(user, extra){
    extra = extra || {};
    const ref = db.collection('users').doc(user.uid);
    const snap = await ref.get();
    if(!snap.exists){
      const referralCode = normalizeReferralCode(extra.referralCode || storedReferralCode());
      let referral = null;
      if(referralCode){
        try{ referral = await resolveReferral(referralCode, user.uid); }catch(err){ console.warn('referral lookup',err); }
      }
      const payload = {
        name: user.displayName || extra.name || '',
        email: user.email || '',
        cashback: 0,
        provider: extra.provider || 'password',
        referralEnabled: false,
        referralCode: null,
        referralCommissionPercent: null,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      };
      if(referral){
        payload.referredByUid = referral.uid;
        payload.referredByCode = referral.code;
        payload.referredAt = firebase.firestore.FieldValue.serverTimestamp();
      }
      await ref.set(payload);
      if(referral){ try{ localStorage.removeItem('puffpod_referral_code'); }catch(e){} }
    } else {
      await ref.update({ lastLogin: firebase.firestore.FieldValue.serverTimestamp() });
    }
  }

  function setLoading(btn, loading, labelWhenIdle){
    btn.disabled = loading;
    btn.textContent = loading ? 'Aguarde…' : labelWhenIdle;
  }


  function closeAccountMenu(){ if(accountMenu) accountMenu.hidden = true; }
  function positionAccountMenu(anchor){
    if(!accountMenu || accountMenu.hidden) return;
    const source = anchor || (window.innerWidth <= 900 ? triggerMobile : trigger);
    if(!source) return;
    const rect = source.getBoundingClientRect();
    const menuWidth = Math.min(290, window.innerWidth - 24);
    const left = Math.max(12, Math.min(window.innerWidth - menuWidth - 12, rect.right - menuWidth));
    accountMenu.style.width = menuWidth + 'px';
    accountMenu.style.left = left + 'px';
    accountMenu.style.top = (rect.bottom + 8) + 'px';
  }
  function toggleAccountMenu(anchor){
    if(!accountMenu || !auth.currentUser) return;
    const willOpen = accountMenu.hidden;
    accountMenu.hidden = !willOpen;
    if(willOpen) requestAnimationFrame(() => positionAccountMenu(anchor));
  }
  function openAccountDetail(title, sub, html){
    closeAccountMenu();
    accountDetailTitle.textContent = title;
    accountDetailSub.textContent = sub || '';
    accountDetailBody.innerHTML = html || '';
    accountDetailModal.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeAccountDetail(){
    if(accountDetailModal) accountDetailModal.hidden = true;
    document.body.style.overflow = '';
  }
  function formatMoney(value){
    const n = Number(value || 0);
    return n.toLocaleString('pt-BR', { style:'currency', currency:'BRL' });
  }
  function formatOrderDate(ts){
    try{
      if(!ts) return 'Data não disponível';
      const d = ts.toDate ? ts.toDate() : new Date(ts);
      return d.toLocaleString('pt-BR', { dateStyle:'short', timeStyle:'short' });
    }catch(e){ return 'Data não disponível'; }
  }
  async function showMyOrders(){
    const user = auth.currentUser;
    if(!user) return;
    openAccountDetail('Minhas compras', 'Pedidos realizados com esta conta.', '<div class="account-loading">Carregando seus pedidos…</div>');
    try{
      const snap = await db.collection('orders').where('uid','==',user.uid).get();
      const orders = snap.docs.map(d => ({ id:d.id, ...d.data() }));
      orders.sort((a,b) => {
        const at = a.createdAt && a.createdAt.toMillis ? a.createdAt.toMillis() : 0;
        const bt = b.createdAt && b.createdAt.toMillis ? b.createdAt.toMillis() : 0;
        return bt-at;
      });
      if(!orders.length){
        accountDetailBody.innerHTML = '<div class="account-empty">Você ainda não possui compras vinculadas a esta conta.</div>';
        return;
      }
      accountDetailBody.innerHTML = orders.map(o => {
        const items = Array.isArray(o.items) ? o.items.map(i => `${i.qty || 1}× ${i.name}`).join('<br>') : 'Itens não disponíveis';
        return `<div class="account-order">
          <div class="account-order-top"><div class="account-order-id">${o.orderId || o.id}</div><div class="account-order-date">${formatOrderDate(o.createdAt)}</div></div>
          <div class="account-order-items">${items}</div>
          <div class="account-order-total">${formatMoney(o.total)}</div>
        </div>`;
      }).join('');
    }catch(err){
      console.error('Erro ao carregar pedidos:', err);
      accountDetailBody.innerHTML = '<div class="account-empty">Não foi possível carregar suas compras agora. Tente novamente em instantes.</div>';
    }
  }
  async function showCashback(){
    const user = auth.currentUser;
    if(!user) return;
    openAccountDetail('Ganhos em Cashback', 'Seu saldo acumulado na Puffpod.', '<div class="account-loading">Consultando seu saldo…</div>');
    try{
      const snap = await db.collection('users').doc(user.uid).get();
      const data = snap.exists ? snap.data() : {};
      const cashback = Number(data.cashback || 0);
      accountDetailBody.innerHTML = `<div class="cashback-box"><small>Saldo disponível</small><strong>${formatMoney(cashback)}</strong><p>O cashback pode ser usado para reduzir o valor de uma próxima compra.</p></div>`;
    }catch(err){
      console.error('Erro ao carregar cashback:', err);
      accountDetailBody.innerHTML = '<div class="account-empty">Não foi possível consultar seu cashback agora.</div>';
    }
  }

  async function showReferral(){
    const user = auth.currentUser;
    if(!user) return;
    openAccountDetail('Ganhos com indicação', 'Acompanhe seu link, comissão e saldo disponível para saque.', '<div class="account-loading">Carregando seus ganhos…</div>');
    try{
      const snap = await db.collection('users').doc(user.uid).get();
      const d = snap.exists ? snap.data() : {};
      if(!d.referralEnabled || !d.referralCode){
        accountDetailBody.innerHTML = '<div class="account-empty">Seu código de indicação ainda não foi liberado pela Puffpod.</div>';
        return;
      }
      const link = location.origin + '/?signup=1&ref=' + encodeURIComponent(d.referralCode);
      const available = Number(d.referralAvailable || 0);
      const total = Number(d.referralEarningsTotal || 0);
      const pending = Number(d.referralPending || 0);
      const withdrawn = Number(d.referralWithdrawn || 0);
      const rate = Number(d.referralCommissionPercent || 0);
      const invitedSnap = await db.collection('users').where('referredByUid','==',user.uid).get().catch(()=>null);
      const invitedCount = invitedSnap ? invitedSnap.size : Number(d.referralInvitedCount || 0);
      accountDetailBody.innerHTML = `<div class="referral-card">
        <small>Seu código</small><div class="referral-code">${d.referralCode}</div><div class="referral-link">${link}</div>
        <button type="button" class="btn solid referral-copy" id="copyReferralLink">Copiar link de indicação</button>
        <div class="referral-earnings-grid">
          <div class="referral-earning"><small>Comissão</small><strong>${rate ? rate+'%' : '—'}</strong></div>
          <div class="referral-earning"><small>Indicados</small><strong>${invitedCount}</strong></div>
          <div class="referral-earning"><small>Ganhos totais</small><strong>${formatMoney(total)}</strong></div>
          <div class="referral-earning"><small>Disponível</small><strong>${formatMoney(available)}</strong></div>
          <div class="referral-earning"><small>Em saque</small><strong>${formatMoney(pending)}</strong></div>
          <div class="referral-earning"><small>Já sacado</small><strong>${formatMoney(withdrawn)}</strong></div>
        </div>
        <button type="button" class="btn solid referral-withdraw" id="referralWithdrawBtn" ${available<=0?'disabled':''}>Sacar</button>
        <div id="referralWithdrawArea"></div>
      </div>`;
      document.getElementById('copyReferralLink')?.addEventListener('click', async (e)=>{
        try{ await navigator.clipboard.writeText(link); e.currentTarget.textContent='Link copiado!'; setTimeout(()=>e.currentTarget.textContent='Copiar link de indicação',1800); }catch(err){ prompt('Copie seu link:',link); }
      });
      document.getElementById('referralWithdrawBtn')?.addEventListener('click', ()=>{
        const area=document.getElementById('referralWithdrawArea');
        area.innerHTML=`<form class="referral-withdraw-form" id="referralWithdrawForm">
          <div class="field"><span>Tipo de chave Pix</span><select id="withdrawPixType" required><option value="cpf">CPF</option><option value="cnpj">CNPJ</option><option value="email">E-mail</option><option value="phone">Telefone</option><option value="random">Chave aleatória</option></select></div>
          <div class="field"><span>Chave Pix</span><input id="withdrawPixKey" required placeholder="Informe a chave para receber"></div>
          <div class="referral-withdraw-note">Será solicitado o saque de todo o saldo disponível: <strong>${formatMoney(available)}</strong>. O valor ficará reservado até a confirmação do pagamento.</div>
          <button type="submit" class="btn solid">Confirmar saque</button>
        </form>`;
        document.getElementById('referralWithdrawForm')?.addEventListener('submit',async(ev)=>{
          ev.preventDefault();
          const submit=ev.currentTarget.querySelector('button[type="submit"]'); submit.disabled=true; submit.textContent='Solicitando…';
          try{
            const token=await user.getIdToken(true);
            const r=await fetch('/api/referral-withdraw',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify({pixType:document.getElementById('withdrawPixType').value,pixKey:document.getElementById('withdrawPixKey').value})});
            const data=await r.json().catch(()=>({})); if(!r.ok) throw new Error(data.error||'Não foi possível solicitar o saque.');
            area.innerHTML=`<div class="referral-success">Saque de ${formatMoney(data.amount)} solicitado com sucesso. O saldo ficou reservado para pagamento.</div>`;
            setTimeout(showReferral,1400);
          }catch(err){ alert(err.message||'Não foi possível solicitar o saque.'); submit.disabled=false; submit.textContent='Confirmar saque'; }
        });
      });
    }catch(err){ console.error(err); accountDetailBody.innerHTML='<div class="account-empty">Não foi possível carregar seus ganhos agora.</div>'; }
  }

  function updateAuthUI(user){
    const label = user ? (user.displayName || user.email || 'Conta').split(' ')[0] : null;
    if(trigger){
      const span = trigger.querySelector('span');
      if(span) span.textContent = label || 'Entrar';
    }
    if(triggerMobile){
      const span = triggerMobile.querySelector('span');
      if(span) span.textContent = label || 'Login';
    }
    if(adminTrigger){
      adminTrigger.hidden = !(user && user.email === ADMIN_EMAIL);
    }
    if(accountMenuName) accountMenuName.textContent = user ? (user.displayName || 'Minha conta') : 'Minha conta';
    if(accountMenuEmail) accountMenuEmail.textContent = user ? (user.email || '') : '';
    if(user){
      startHeartbeat(user.uid);
      if(accountReferralBtn){
        accountReferralBtn.hidden = true;
        db.collection('users').doc(user.uid).get().then(s=>{ const d=s.exists?s.data():{}; accountReferralBtn.hidden=!(d.referralEnabled && d.referralCode); }).catch(()=>{});
      }
    } else {
      if(accountReferralBtn) accountReferralBtn.hidden = true;
      closeAccountMenu();
      closeAccountDetail();
      stopHeartbeat();
    }
  }

  function handleTriggerClick(e){
    if(e) e.stopPropagation();
    if(auth.currentUser){
      toggleAccountMenu(e && e.currentTarget ? e.currentTarget : null);
    } else {
      showLogin();
      openModal();
    }
  }

  trigger && trigger.addEventListener('click', handleTriggerClick);
  triggerMobile && triggerMobile.addEventListener('click', handleTriggerClick);
  accountMenu && accountMenu.addEventListener('click', (e) => e.stopPropagation());
  document.addEventListener('click', () => closeAccountMenu());
  window.addEventListener('resize', () => { if(accountMenu && !accountMenu.hidden) positionAccountMenu(); });
  accountCartBtn && accountCartBtn.addEventListener('click', () => { closeAccountMenu(); if(window.openPuffCart) window.openPuffCart(); });
  accountOrdersBtn && accountOrdersBtn.addEventListener('click', showMyOrders);
  accountCashbackBtn && accountCashbackBtn.addEventListener('click', showCashback);
  accountReferralBtn && accountReferralBtn.addEventListener('click', showReferral);
  accountLogoutBtn && accountLogoutBtn.addEventListener('click', async () => { closeAccountMenu(); await auth.signOut(); });
  accountDetailClose && accountDetailClose.addEventListener('click', closeAccountDetail);
  accountDetailScrim && accountDetailScrim.addEventListener('click', closeAccountDetail);
  closeBtn.addEventListener('click', closeModal);
  scrim.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if(e.key === 'Escape' && !modal.hidden) closeModal(); });

  btnGoSignup.addEventListener('click', showSignup);
  btnGoLogin.addEventListener('click', showLogin);

  auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL).catch(() => {});
  auth.useDeviceLanguage();

  googleBtn.addEventListener('click', async () => {
    hideNote();
    const original = googleBtn.innerHTML;
    googleBtn.disabled = true;
    googleBtn.querySelector('span').textContent = 'Abrindo Google…';
    const provider = new firebase.auth.GoogleAuthProvider();
    provider.setCustomParameters({ prompt: 'select_account' });
    try{
      const cred = await auth.signInWithPopup(provider);
      await ensureUserDoc(cred.user, { provider: 'google' });
      closeModal();
    }catch(err){
      console.error('Google login error:', err);
      const msg = friendlyError(err);
      if(msg) showNote(msg, true);
      if(err && (err.code === 'auth/popup-blocked' || err.code === 'auth/operation-not-supported-in-this-environment')){
        try{
          await auth.signInWithRedirect(provider);
          return;
        }catch(redirectErr){
          console.error('Google redirect login error:', redirectErr);
          showNote(friendlyError(redirectErr), true);
        }
      }
    }finally{
      googleBtn.disabled = false;
      googleBtn.innerHTML = original;
    }
  });

  auth.getRedirectResult().then(async (result) => {
    if(result && result.user){
      await ensureUserDoc(result.user, { provider: 'google' });
      closeModal();
    }
  }).catch((err) => {
    console.error('Google redirect result error:', err);
    const msg = friendlyError(err);
    if(msg){ showLogin(); openModal(); showNote(msg, true); }
  });

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideNote();
    const email = document.getElementById('loginEmail').value.trim();
    const password = document.getElementById('loginPassword').value;
    const btn = loginForm.querySelector('.auth-submit');
    setLoading(btn, true);
    try{
      await auth.signInWithEmailAndPassword(email, password);
      closeModal();
    }catch(err){
      showNote(friendlyError(err), false);
    }finally{
      setLoading(btn, false, 'Entrar');
    }
  });

  signupForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideNote();
    const name = document.getElementById('signupName').value.trim();
    const email = document.getElementById('signupEmail').value.trim();
    const p1 = document.getElementById('signupPassword').value;
    const p2 = document.getElementById('signupPassword2').value;
    const referralCode = normalizeReferralCode(signupReferral ? signupReferral.value : '');
    if(referralCode){
      try{
        const validReferral = await resolveReferral(referralCode, null);
        if(!validReferral){ showNote('Código de indicação inválido ou ainda não liberado.', false); return; }
        try{ localStorage.setItem('puffpod_referral_code', referralCode); }catch(err){}
      }catch(err){ showNote('Não foi possível validar o código de indicação agora. Tente novamente.', false); return; }
    }
    if(p1 !== p2){
      showNote('As senhas não coincidem. Confira e tente de novo.', false);
      return;
    }
    const btn = signupForm.querySelector('.auth-submit');
    setLoading(btn, true);
    try{
      const cred = await auth.createUserWithEmailAndPassword(email, p1);
      await cred.user.updateProfile({ displayName: name });
      await ensureUserDoc(cred.user, { name, provider: 'password', referralCode });
      closeModal();
    }catch(err){
      showNote(friendlyError(err), false);
    }finally{
      setLoading(btn, false, 'Criar conta');
    }
  });

  auth.onAuthStateChanged((user)=>{
    updateAuthUI(user);
    if(!user && signupRequested){ showSignup(); openModal(); }
  });
})();

/* ---------- product stock, prices & promotions (Firestore "products" collection) ---------- */
(function(){
  if(!window.db) return;
  const db = window.db;
  window.PRODUCT_STOCK = {};
  window.PRODUCT_CONFIG = {};

  function num(v, fallback=0){ const n=Number(v); return Number.isFinite(n)?n:fallback; }
  function money(v){ return 'R$ ' + num(v).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  window.formatProductMoney = money;

  function productById(id){ return (window.PRODUCTS||[]).find(p=>p.id===id); }
  function applyConfigToProduct(id, data={}){
    const p=productById(id); if(!p) return;
    if(p._initialBasePrice == null) p._initialBasePrice = num(p.basePrice, num(String(p.defaultPrice||p.price).replace('R$','').replace(/\./g,'').replace(',','.')));
    const regular = data.price != null ? num(data.price,p._initialBasePrice) : p._initialBasePrice;
    const promoActive = data.promotionActive === true;
    const promoFrom = data.promotionOriginalPrice != null ? num(data.promotionOriginalPrice,regular) : regular;
    const promoTo = data.promotionPrice != null ? num(data.promotionPrice,regular) : regular;
    p.basePrice = regular; p.promotionActive = promoActive && promoTo>0; p.promotionOriginalPrice=promoFrom; p.promotionPrice=promoTo;
    p.price = money(p.promotionActive ? promoTo : regular);
  }

  function priceMarkup(p, compact=false){
    if(p && p.promotionActive){
      return `<span class="old-price">De ${money(p.promotionOriginalPrice||p.basePrice)}</span><span class="current-price">Por ${money(p.promotionPrice)}</span>${compact?'':'<small>à vista</small>'}`;
    }
    return `<span class="current-price">${money(p?.basePrice ?? 0)}</span>${compact?'':'<small>à vista</small>'}`;
  }
  window.productPriceMarkup=priceMarkup;

  function applyPricingUI(){
    (window.PRODUCTS||[]).forEach(p=>{
      document.querySelectorAll(`[data-product-id="${CSS.escape(p.id)}"]`).forEach(el=>{
        el.classList.toggle('promo-active',!!p.promotionActive);
        let badge=el.querySelector(':scope > .promo-badge');
        if(p.promotionActive && !badge && (el.classList.contains('catalog-card')||el.classList.contains('card'))){ badge=document.createElement('span');badge.className='promo-badge';badge.textContent='Promoção';el.prepend(badge); }
        if(!p.promotionActive && badge) badge.remove();
        const price=el.querySelector('.price');
        if(price) price.innerHTML=priceMarkup(p, el.classList.contains('card')&&!el.classList.contains('catalog-card'));
        if(el.dataset.price!=null) el.dataset.price=String(p.promotionActive?p.promotionPrice:p.basePrice);
      });
    });
    const pm=document.getElementById('productModal');
    if(pm && !pm.hidden && pm.dataset.productId){
      const p=productById(pm.dataset.productId), pe=document.getElementById('pmPrice');
      if(p&&pe){pe.classList.toggle('promo-price',!!p.promotionActive);pe.innerHTML=priceMarkup(p,true);}
    }
    if(window.refreshCartPrices) window.refreshCartPrices();
  }
  window.applyProductPricingUI=applyPricingUI;

  function applyStockUI(){
    const stock = window.PRODUCT_STOCK;
    document.querySelectorAll('[data-product-id]').forEach(el => {
      const id = el.dataset.productId;
      const out = !!stock[id];
      el.classList.toggle('out-of-stock', out);
      const existingBadge = el.querySelector(':scope > .out-of-stock-badge');
      if(out && !existingBadge && (el.classList.contains('catalog-card') || el.classList.contains('card'))){
        const badge = document.createElement('span'); badge.className='out-of-stock-badge'; badge.textContent='Em falta'; el.prepend(badge);
      } else if(!out && existingBadge){ existingBadge.remove(); }
      const photoInfo=el.querySelector('.photo-info'); let strip=el.querySelector('.out-of-stock-strip');
      if(out&&photoInfo&&!strip){strip=document.createElement('div');strip.className='out-of-stock-strip';strip.textContent='Produto indisponível no momento';photoInfo.insertBefore(strip,photoInfo.firstChild);}else if(!out&&strip){strip.remove();}
      const addBtn=el.querySelector('.add-cart-btn');
      if(addBtn){const label=addBtn.querySelector('span');if(label&&!addBtn.dataset.defaultLabel)addBtn.dataset.defaultLabel=label.textContent.trim();if(out){addBtn.disabled=true;addBtn.classList.add('btn-out-of-stock');addBtn.setAttribute('aria-label','Produto indisponível');if(label)label.textContent='Indisponível';}else{addBtn.disabled=false;addBtn.classList.remove('btn-out-of-stock');addBtn.setAttribute('aria-label',`Adicionar ${el.querySelector('h4')?.textContent||'produto'} ao carrinho`);if(label)label.textContent=addBtn.dataset.defaultLabel||'Adicionar';}}
    });
    const pmModal=document.getElementById('productModal');
    if(pmModal){const id=pmModal.dataset.productId;const out=id&&stock[id];const media=document.getElementById('pmMedia');const addCart=document.getElementById('pmAddCart');const buyNow=document.getElementById('pmBuyNow');let noteEl=document.getElementById('pmStockNote');if(media)media.classList.toggle('out-of-stock-media',!!out);if(addCart)addCart.disabled=!!out;if(buyNow)buyNow.disabled=!!out;if(out&&!noteEl){noteEl=document.createElement('div');noteEl.id='pmStockNote';noteEl.className='pm-out-of-stock-note';noteEl.textContent='Produto sem estoque no momento.';const actions=document.querySelector('.pm-actions');if(actions)actions.parentNode.insertBefore(noteEl,actions);}else if(!out&&noteEl){noteEl.remove();}}
  }
  window.applyStockUI=applyStockUI;

  window.setProductStock=function(id,outOfStock){return db.collection('products').doc(id).set({outOfStock},{merge:true});};
  window.saveProductAdminConfig=function(id,config){
    const payload={
      price:num(config.price), promotionActive:!!config.promotionActive,
      promotionOriginalPrice:num(config.promotionOriginalPrice), promotionPrice:num(config.promotionPrice),
      updatedAt:firebase.firestore.FieldValue.serverTimestamp()
    };
    if(payload.price<=0) return Promise.reject(new Error('Informe um preço válido.'));
    if(payload.promotionActive && (payload.promotionOriginalPrice<=0 || payload.promotionPrice<=0 || payload.promotionPrice>=payload.promotionOriginalPrice)) return Promise.reject(new Error('Na promoção, o valor “Por” deve ser menor que o valor “De”.'));
    return db.collection('products').doc(id).set(payload,{merge:true});
  };

  db.collection('products').onSnapshot(snap=>{
    snap.forEach(doc=>{const d=doc.data()||{};window.PRODUCT_STOCK[doc.id]=!!d.outOfStock;window.PRODUCT_CONFIG[doc.id]=d;applyConfigToProduct(doc.id,d);});
    // Products with no Firestore document keep their built-in price.
    (window.PRODUCTS||[]).forEach(p=>{if(!window.PRODUCT_CONFIG[p.id]) applyConfigToProduct(p.id,{});});
    applyPricingUI();applyStockUI();
    if(window.reloadAdminProducts) window.reloadAdminProducts();
  },()=>{});
})();

/* ---------- product detail modal ---------- */
(function(){
  const modal = document.getElementById('productModal');
  const scrim = document.getElementById('productModalScrim');
  const closeBtn = document.getElementById('productModalClose');
  const media = document.getElementById('pmMedia');
  const tagEl = document.getElementById('pmTag');
  const nameEl = document.getElementById('pmName');
  const priceEl = document.getElementById('pmPrice');
  const descEl = document.getElementById('pmDesc');
  const qtyValue = document.getElementById('pmQtyValue');
  const qtyMinus = document.getElementById('pmQtyMinus');
  const qtyPlus = document.getElementById('pmQtyPlus');
  const addCartBtn = document.getElementById('pmAddCart');
  const buyNowBtn = document.getElementById('pmBuyNow');
  const whatsappLink = document.getElementById('pmWhatsapp');
  if(!modal) return;

  let currentProduct = null;
  let qty = 1;

  function renderMedia(p){
    if(p.bg){
      media.innerHTML = `
        <div class="pm-bg"><img src="${p.bg}" alt=""></div>
        <div class="pm-pod"><img src="${p.image}" alt="${p.name}"></div>
      `;
    } else if(p.image){
      media.innerHTML = `<div class="pm-icon"><img src="${p.image}" alt="${p.name}"></div>`;
    } else {
      media.innerHTML = `<div class="pm-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">${p.icon}</svg></div>`;
    }
  }

  window.openProductModal = function(p){
    currentProduct = p;
    qty = 1;
    qtyValue.textContent = qty;
    media.style.setProperty('--card-glow', p.glow);
    renderMedia(p);
    tagEl.textContent = `${p.tag} · ${p.brand} · ${(p.puffs/1000)}k puffs`;
    nameEl.textContent = p.name;
    priceEl.classList.toggle('promo-price', !!p.promotionActive);
    priceEl.innerHTML = window.productPriceMarkup ? window.productPriceMarkup(p, true) : p.price;
    descEl.textContent = p.desc;
    whatsappLink.href = `https://wa.me/5541999990000?text=${encodeURIComponent('Olá! Tenho interesse no produto: ' + p.name)}`;
    modal.dataset.productId = p.id;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    if(window.applyStockUI) window.applyStockUI();
  };

  function closeModal(){
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  scrim.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if(e.key === 'Escape' && !modal.hidden) closeModal(); });

  qtyMinus.addEventListener('click', () => { if(qty > 1){ qty--; qtyValue.textContent = qty; } });
  qtyPlus.addEventListener('click', () => { qty++; qtyValue.textContent = qty; });

  function flashAdded(btn, label){
    const prev = btn.textContent;
    btn.textContent = label;
    btn.classList.add('added');
    setTimeout(() => { btn.textContent = prev; btn.classList.remove('added'); }, 1000);
  }

  addCartBtn.addEventListener('click', () => {
    if(!currentProduct) return;
    for(let i = 0; i < qty; i++) window.addToCart(currentProduct);
    flashAdded(addCartBtn, 'Adicionado!');
  });

  buyNowBtn.addEventListener('click', () => {
    if(!currentProduct) return;
    for(let i = 0; i < qty; i++) window.addToCart(currentProduct);
    const checkoutBtn = document.getElementById('cartCheckoutBtn');
    if(checkoutBtn && checkoutBtn.href) window.location.href = checkoutBtn.href;
  });
})();

/* ---------- catalog list with filters ---------- */
(function(){
  const products = window.PRODUCTS || [];
  const grid = document.getElementById('catalogGrid');
  const filtersWrap = document.getElementById('filters');
  const emptyMsg = document.getElementById('catalogEmpty');
  const advToggle = document.getElementById('advToggle');
  const advPanel = document.getElementById('advPanel');
  const brandSelect = document.getElementById('brandFilter');
  const priceWrap = document.getElementById('priceFilters');
  const puffWrap = document.getElementById('puffFilters');
  const clearAdv = document.getElementById('clearAdv');
  if(!grid || !filtersWrap) return;

  const priceOf = str => parseFloat(str.replace('R$','').trim().replace(/\./g,'').replace(',', '.'));

  const priceRanges = [
    { label:'Todos', test:() => true },
    { label:'Até R$ 300', test:v => v <= 300 },
    { label:'R$ 300–700', test:v => v > 300 && v <= 700 },
    { label:'R$ 700–1.200', test:v => v > 700 && v <= 1200 },
    { label:'Acima de R$ 1.200', test:v => v > 1200 }
  ];

  const puffOptions = ['Todos', '1k', '5k', '10k', '15k', '23k', '30k', '40k'];

  const tags = ['Todos', ...new Set(products.map(p => p.tag))];
  const brands = ['Todas', ...new Set(products.map(p => p.brand))];

  let activeTag = 'Todos';
  let activeBrand = 'Todas';
  let activePrice = 'Todos';
  let activePuff = 'Todos';

  // category chips
  tags.forEach(tag => {
    const chip = document.createElement('button');
    chip.className = 'filter-chip' + (tag === activeTag ? ' active' : '');
    chip.textContent = tag;
    chip.addEventListener('click', () => {
      activeTag = tag;
      filtersWrap.querySelectorAll('.filter-chip').forEach(c => c.classList.toggle('active', c.textContent === tag));
      applyFilter();
    });
    filtersWrap.appendChild(chip);
  });

  // brand select
  brands.forEach(b => {
    const opt = document.createElement('option');
    opt.value = b; opt.textContent = b === 'Todas' ? 'Todas as marcas' : b;
    brandSelect.appendChild(opt);
  });
  brandSelect.addEventListener('change', () => {
    activeBrand = brandSelect.value;
    applyFilter();
  });

  // price chips
  priceRanges.forEach(r => {
    const chip = document.createElement('button');
    chip.className = 'filter-chip' + (r.label === activePrice ? ' active' : '');
    chip.textContent = r.label;
    chip.addEventListener('click', () => {
      activePrice = r.label;
      priceWrap.querySelectorAll('.filter-chip').forEach(c => c.classList.toggle('active', c.textContent === r.label));
      applyFilter();
    });
    priceWrap.appendChild(chip);
  });

  // puff quantity chips
  puffOptions.forEach(label => {
    const chip = document.createElement('button');
    chip.className = 'filter-chip' + (label === activePuff ? ' active' : '');
    chip.textContent = label;
    chip.addEventListener('click', () => {
      activePuff = label;
      puffWrap.querySelectorAll('.filter-chip').forEach(c => c.classList.toggle('active', c.textContent === label));
      applyFilter();
    });
    puffWrap.appendChild(chip);
  });

  // advanced panel toggle
  advToggle.addEventListener('click', () => {
    const open = advPanel.classList.toggle('open');
    advToggle.classList.toggle('active', open);
    advToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  clearAdv.addEventListener('click', () => {
    activeBrand = 'Todas'; activePrice = 'Todos'; activePuff = 'Todos';
    brandSelect.value = 'Todas';
    priceWrap.querySelectorAll('.filter-chip').forEach(c => c.classList.toggle('active', c.textContent === 'Todos'));
    puffWrap.querySelectorAll('.filter-chip').forEach(c => c.classList.toggle('active', c.textContent === 'Todos'));
    applyFilter();
  });

  // render cards
  products.forEach(p => {
    const card = document.createElement('div');
    card.className = 'catalog-card';
    card.dataset.tag = p.tag;
    card.dataset.brand = p.brand;
    card.dataset.price = priceOf(p.price);
    card.dataset.puffs = p.puffs;
    card.dataset.productId = p.id;
    card.style.setProperty('--card-glow', p.glow);

    if(p.compositeCard){
      card.className = 'catalog-card composite-card' + (p.layeredPodCard ? ' layered-pod-card' : '');
      card.innerHTML = `
        <div class="composite-media">
          <img class="composite-bg" src="${p.layeredPodCard ? p.bg : p.image}" alt="">
          <div class="composite-pod-motion" aria-hidden="true"><img src="${p.image}" alt="${p.name}"></div>
        </div>
        <div class="composite-info">
          <div class="card-tag">${p.tag}</div>
          <div class="card-brand">${p.brand} · ${(p.puffs/1000)}k puffs</div>
          <h4>${p.name}</h4>
          <div class="card-foot">
            <div class="price">${p.price}<small>à vista</small></div>
            <button class="add-cart-btn" type="button" aria-label="Adicionar ${p.name} ao carrinho">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1.4" fill="currentColor" stroke="none"/><circle cx="18" cy="21" r="1.4" fill="currentColor" stroke="none"/><path d="M2.5 3h2l2.6 12.6a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.6L21 8H6"/></svg>
              <span>Adicionar</span>
            </button>
          </div>
        </div>
      `;
    } else if(p.bg){
      card.className = 'catalog-card photo-card';
      card.innerHTML = `
        <div class="photo-bg"><img src="${p.bg}" alt=""></div>
        <div class="pod-float"><img src="${p.image}" alt="${p.name}"></div>
        <div class="photo-info">
          <div class="card-tag">${p.tag}</div>
          <div class="card-brand">${p.brand} · ${(p.puffs/1000)}k puffs</div>
          <h4>${p.name}</h4>
          <div class="card-foot">
            <div class="price">${p.price}<small>à vista</small></div>
            <button class="add-cart-btn" type="button" aria-label="Adicionar ${p.name} ao carrinho">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1.4" fill="currentColor" stroke="none"/><circle cx="18" cy="21" r="1.4" fill="currentColor" stroke="none"/><path d="M2.5 3h2l2.6 12.6a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.6L21 8H6"/></svg>
              <span>Adicionar</span>
            </button>
          </div>
        </div>
      `;
    } else {
      const media = p.image
        ? `<img src="${p.image}" alt="${p.name}">`
        : `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${p.icon}</svg>`;
      card.innerHTML = `
        <div class="card-icon${p.image ? ' has-photo' : ''}">${media}</div>
        <div class="card-tag">${p.tag}</div>
        <div class="card-brand">${p.brand} · ${(p.puffs/1000)}k puffs</div>
        <h4>${p.name}</h4>
        <div class="card-foot">
          <div class="price">${p.price}<small>à vista</small></div>
          <button class="add-cart-btn" type="button" aria-label="Adicionar ${p.name} ao carrinho">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1.4" fill="currentColor" stroke="none"/><circle cx="18" cy="21" r="1.4" fill="currentColor" stroke="none"/><path d="M2.5 3h2l2.6 12.6a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.6L21 8H6"/></svg>
            <span>Adicionar</span>
          </button>
        </div>
      `;
    }
    grid.appendChild(card);

    card.style.cursor = 'pointer';
    card.addEventListener('click', () => window.openProductModal(p));

    card.querySelector('.add-cart-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      addToCart(p);
      const btn = e.currentTarget;
      btn.classList.add('added');
      const label = btn.querySelector('span');
      const prevText = label.textContent;
      label.textContent = 'Adicionado';
      setTimeout(() => { btn.classList.remove('added'); label.textContent = prevText; }, 1100);
    });

    // mobile: touch = elevate 3D, same as hover
    card.addEventListener('touchstart', () => card.classList.add('touch-active'), { passive:true });
    card.addEventListener('touchend', () => setTimeout(() => card.classList.remove('touch-active'), 350));
  });

  const cards = grid.querySelectorAll('.catalog-card');

  function applyFilter(){
    let visibleCount = 0;
    const priceRange = priceRanges.find(r => r.label === activePrice) || priceRanges[0];
    const puffValue = activePuff === 'Todos' ? null : parseInt(activePuff) * 1000;
    cards.forEach(c => {
      const matchesTag = activeTag === 'Todos' || c.dataset.tag === activeTag;
      const matchesBrand = activeBrand === 'Todas' || c.dataset.brand === activeBrand;
      const matchesPrice = priceRange.test(parseFloat(c.dataset.price));
      const matchesPuff = puffValue === null || parseInt(c.dataset.puffs) === puffValue;
      const show = matchesTag && matchesBrand && matchesPrice && matchesPuff;
      c.classList.toggle('hide', !show);
      if(show) visibleCount++;
    });
    emptyMsg.hidden = visibleCount > 0;
  }

  applyFilter();
})();

/* ---------- hero rotating banner ---------- */
(function(){
  const slides = [
    { image:'assets/embedded/adc5aba841822287.png' },
    { image:'assets/embedded/2b12245f0f7c7ec0.png' },
    { image:'assets/embedded/784b3729345d9e41.png' },
    { image:'assets/embedded/bfc2441a794383b6.png' }
  ];

  const track = document.getElementById('heroTrack');
  const dotsWrap = document.getElementById('heroDots');
  const banner = document.getElementById('heroBanner');
  if(!track || !dotsWrap || !banner || !slides.length) return;

  let current = 0;
  let timer = null;

  slides.forEach((slideData, i) => {
    const slide = document.createElement('div');
    slide.className = 'hero-slide no-link';
    slide.innerHTML = `<img src="${slideData.image}" alt="Banner Puffpod ${i + 1}">`;
    track.appendChild(slide);

    const dot = document.createElement('button');
    dot.className = 'dot';
    dot.setAttribute('aria-label', `Ir para o banner ${i + 1}`);
    dot.addEventListener('click', () => goTo(i));
    dotsWrap.appendChild(dot);
  });

  const slideEls = track.querySelectorAll('.hero-slide');
  const dots = dotsWrap.querySelectorAll('.dot');

  function render(){
    slideEls.forEach((el, i) => el.classList.toggle('is-active', i === current));
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }
  function goTo(i){ current = (i + slides.length) % slides.length; render(); restart(); }
  function next(){ goTo(current + 1); }
  function prev(){ goTo(current - 1); }
  function restart(){ clearInterval(timer); timer = setInterval(() => { current = (current + 1) % slides.length; render(); }, 4200); }

  document.getElementById('heroNext')?.addEventListener('click', next);
  document.getElementById('heroPrev')?.addEventListener('click', prev);

  let startX = 0, startY = 0, dragging = false;
  banner.addEventListener('touchstart', (e) => {
    const t = e.touches[0];
    startX = t.clientX; startY = t.clientY; dragging = true;
    clearInterval(timer);
  }, { passive:true });
  banner.addEventListener('touchmove', (e) => {
    if(!dragging) return;
    const t = e.touches[0];
    const dx = t.clientX - startX, dy = t.clientY - startY;
    if(Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) e.preventDefault();
  }, { passive:false });
  banner.addEventListener('touchend', (e) => {
    if(!dragging) return;
    dragging = false;
    const t = e.changedTouches[0];
    const dx = t.clientX - startX, dy = t.clientY - startY;
    if(Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) dx < 0 ? next() : prev();
    else restart();
  }, { passive:true });

  render();
  restart();
})();

/* ---------- admin panel ---------- */
(function(){
  const modal = document.getElementById('adminModal');
  const scrim = document.getElementById('adminModalScrim');
  const closeBtn = document.getElementById('adminModalClose');
  const trigger = document.getElementById('adminTrigger');
  if(!modal || !window.db) return;
  const db = window.db;

  function openModal(){
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    loadStockTab();
  }
  function closeModal(){
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  function ensureAdminMfaUi(){
    let gate = document.getElementById('adminMfaGate');
    if(gate) return gate;

    const style = document.createElement('style');
    style.textContent = `
      #adminMfaGate{position:fixed;inset:0;z-index:99999;display:grid;place-items:center;padding:20px;background:rgba(1,10,18,.82);backdrop-filter:blur(12px)}
      #adminMfaGate[hidden]{display:none}
      .admin-mfa-card{width:min(440px,100%);background:linear-gradient(160deg,#0a3a5c,#041f34);border:1px solid rgba(72,202,228,.28);border-radius:24px;padding:26px;box-shadow:0 28px 90px rgba(0,0,0,.55);color:#eaf6fb}
      .admin-mfa-top{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:18px}
      .admin-mfa-kicker{font:600 .68rem 'JetBrains Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#48cae4;margin-bottom:6px}
      .admin-mfa-title{font:700 1.55rem 'Baloo 2',sans-serif;line-height:1.1}
      .admin-mfa-close{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.13);background:#062a44;color:#caf0f8;font-size:1.2rem;cursor:pointer}
      .admin-mfa-copy{font-size:.86rem;line-height:1.55;color:#9ec0d8;margin-bottom:18px}
      .admin-mfa-input{width:100%;font:700 1.35rem 'JetBrains Mono',monospace;letter-spacing:.28em;text-align:center;background:#031b2e;color:#fff;border:1px solid rgba(72,202,228,.35);border-radius:14px;padding:14px 16px;outline:none}
      .admin-mfa-input:focus{border-color:#48cae4;box-shadow:0 0 0 3px rgba(72,202,228,.12)}
      .admin-mfa-primary{width:100%;border:0;border-radius:999px;padding:13px 16px;font:700 .85rem 'Manrope',sans-serif;cursor:pointer;margin-top:12px}
      .admin-mfa-primary{background:linear-gradient(90deg,#00b4d8,#2ec4b6);color:#02131f}
      .admin-mfa-msg{min-height:20px;margin-top:10px;font-size:.78rem;color:#ff9b9f;text-align:center}
    `;
    document.head.appendChild(style);

    gate = document.createElement('div');
    gate.id = 'adminMfaGate';
    gate.hidden = true;
    gate.innerHTML = `
      <div class="admin-mfa-card" role="dialog" aria-modal="true" aria-labelledby="adminMfaTitle">
        <div class="admin-mfa-top">
          <div><div class="admin-mfa-kicker">Segurança administrativa</div><div class="admin-mfa-title" id="adminMfaTitle">Microsoft Authenticator</div></div>
          <button class="admin-mfa-close" type="button" aria-label="Fechar">×</button>
        </div>
        <p class="admin-mfa-copy">Digite o código de 6 dígitos do Microsoft Authenticator para acessar o Painel Admin.</p>
        <form id="adminMfaForm">
          <input id="adminMfaCode" class="admin-mfa-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" aria-label="Código de 6 dígitos">
          <button class="admin-mfa-primary" type="submit">Validar e acessar</button>
        </form>
        <div id="adminMfaMsg" class="admin-mfa-msg"></div>
      </div>`;
    document.body.appendChild(gate);
    return gate;
  }

  async function callAdminMfa(payload){
    const user = window.auth && window.auth.currentUser;
    if(!user) throw new Error('Sessão administrativa não encontrada.');
    const idToken = await user.getIdToken(true);
    const res = await fetch('/api/admin-mfa', {
      method:'POST',
      headers:{'Content-Type':'application/json','Authorization':'Bearer ' + idToken},
      body:JSON.stringify(payload)
    });
    const data = await res.json().catch(() => ({}));
    if(!res.ok) throw new Error(data.error || 'Não foi possível validar o MFA.');
    return data;
  }

  async function verifyAdminMfa(){
    const user = window.auth && window.auth.currentUser;
    if(!user || String(user.email||'').toLowerCase() !== 'support.puffpod@gmail.com') return false;

    const cacheKey = 'puffpod_admin_mfa_verified';
    try{
      const cached = JSON.parse(sessionStorage.getItem(cacheKey) || 'null');
      if(cached && cached.uid === user.uid && Date.now() - Number(cached.at || 0) < 10 * 60 * 1000) return true;
    }catch(e){}

    const gate = ensureAdminMfaUi();
    const form = gate.querySelector('#adminMfaForm');
    const input = gate.querySelector('#adminMfaCode');
    const msg = gate.querySelector('#adminMfaMsg');
    const close = gate.querySelector('.admin-mfa-close');

    gate.hidden = false;
    input.value = '';
    msg.textContent = '';
    setTimeout(() => input.focus(), 40);

    return await new Promise(resolve => {
      let finished = false;
      const finish = ok => {
        if(finished) return;
        finished = true;
        gate.hidden = true;
        form.removeEventListener('submit', onSubmit);
        close.removeEventListener('click', onClose);
        gate.removeEventListener('click', onScrim);
        document.removeEventListener('keydown', onKey);
        resolve(ok);
      };
      const onClose = () => finish(false);
      const onScrim = e => { if(e.target === gate) finish(false); };
      const onKey = e => { if(e.key === 'Escape') finish(false); };
      const onSubmit = async e => {
        e.preventDefault();
        const code = String(input.value||'').replace(/\D/g,'').slice(0,6);
        if(code.length !== 6){ msg.style.color='#ff9b9f'; msg.textContent='Digite os 6 dígitos.'; return; }
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        msg.style.color = '#9ec0d8';
        msg.textContent = 'Validando…';
        try{
          const data = await callAdminMfa({action:'verify', code});
          if(data.ok){
            sessionStorage.setItem(cacheKey, JSON.stringify({uid:user.uid,at:Date.now()}));
            finish(true);
          }
        }catch(err){
          msg.style.color = '#ff9b9f';
          msg.textContent = err.message || 'Código inválido ou expirado.';
          input.select();
        }finally{ btn.disabled = false; }
      };
      form.addEventListener('submit', onSubmit);
      close.addEventListener('click', onClose);
      gate.addEventListener('click', onScrim);
      document.addEventListener('keydown', onKey);
    });
  }

  trigger && trigger.addEventListener('click', async () => {
    if(await verifyAdminMfa()) openModal();
  });
  closeBtn.addEventListener('click', closeModal);
  scrim.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if(e.key === 'Escape' && !modal.hidden) closeModal(); });

  // tabs
  const tabs = modal.querySelectorAll('.admin-tab');
  const panes = {
    estoque: document.getElementById('paneEstoque'),
    usuarios: document.getElementById('paneUsuarios'),
    indicadores: document.getElementById('paneIndicadores'),
    vendas: document.getElementById('paneVendas'),
    pedidos: document.getElementById('panePedidos'),
    naocompraram: document.getElementById('paneNaoCompraram')
  };
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      Object.keys(panes).forEach(key => { panes[key].hidden = (key !== tab.dataset.tab); });
      if(tab.dataset.tab === 'usuarios') loadUsersTab();
      if(tab.dataset.tab === 'indicadores') loadReferralsTab();
      if(tab.dataset.tab === 'vendas') loadSalesTab('day');
      if(tab.dataset.tab === 'pedidos') loadOrdersTab();
      if(tab.dataset.tab === 'naocompraram') loadNonBuyersTab();
    });
  });

  // ---------- estoque tab ----------
  function loadStockTab(){
    const list=document.getElementById('adminStockList');
    const products=window.PRODUCTS||[];
    const money=window.formatProductMoney||((v)=>'R$ '+Number(v||0).toFixed(2).replace('.',','));
    list.innerHTML=products.map(p=>{
      const cfg=(window.PRODUCT_CONFIG&&window.PRODUCT_CONFIG[p.id])||{};
      const regular=Number(cfg.price ?? p.basePrice ?? 0);
      const active=cfg.promotionActive===true;
      const from=Number(cfg.promotionOriginalPrice ?? regular);
      const to=Number(cfg.promotionPrice ?? Math.max(.01,regular-.01));
      return `<div class="admin-product-row" data-admin-product="${p.id}">
        <div class="admin-product-top"><div><div class="admin-product-name">${p.name}</div><div class="admin-product-meta">${p.brand} · preço atual ${p.price}</div></div></div>
        <div class="admin-product-grid">
          <label class="admin-product-field"><span>Preço normal (R$)</span><input type="number" min="0.01" step="0.01" data-field="price" value="${regular.toFixed(2)}"></label>
          <label class="admin-product-field"><span>Promoção — De (R$)</span><input type="number" min="0.01" step="0.01" data-field="promotionOriginalPrice" value="${from.toFixed(2)}"></label>
          <label class="admin-product-field"><span>Promoção — Por (R$)</span><input type="number" min="0.01" step="0.01" data-field="promotionPrice" value="${to.toFixed(2)}"></label>
        </div>
        <div class="admin-product-actions">
          <label class="admin-promo-check"><input type="checkbox" data-field="promotionActive" ${active?'checked':''}> Ativar promoção</label>
          <button type="button" class="admin-product-save">Salvar preço / promoção</button>
          <div class="admin-stock-inline"><span>Em falta</span><div class="admin-toggle ${window.PRODUCT_STOCK&&window.PRODUCT_STOCK[p.id]?'on':''}" data-stock-id="${p.id}" role="button" aria-label="Marcar ${p.name} como em falta"></div></div>
        </div>
      </div>`;
    }).join('');
    list.querySelectorAll('[data-stock-id]').forEach(toggle=>toggle.addEventListener('click',async()=>{const id=toggle.dataset.stockId;const state=!toggle.classList.contains('on');toggle.classList.toggle('on',state);try{await window.setProductStock(id,state);}catch(e){toggle.classList.toggle('on',!state);alert('Não foi possível alterar o estoque.');}}));
    list.querySelectorAll('.admin-product-save').forEach(btn=>btn.addEventListener('click',async()=>{
      const row=btn.closest('[data-admin-product]'),id=row.dataset.adminProduct;
      const val=(key)=>Number(row.querySelector(`[data-field="${key}"]`).value);
      const config={price:val('price'),promotionOriginalPrice:val('promotionOriginalPrice'),promotionPrice:val('promotionPrice'),promotionActive:row.querySelector('[data-field="promotionActive"]').checked};
      btn.disabled=true;const old=btn.textContent;btn.textContent='Salvando…';
      try{await window.saveProductAdminConfig(id,config);btn.textContent='Salvo ✓';setTimeout(()=>{btn.textContent=old;btn.disabled=false;},900);}catch(e){alert(e.message||'Não foi possível salvar o produto.');btn.textContent=old;btn.disabled=false;}
    }));
  }
  window.reloadAdminProducts=()=>{const pane=document.getElementById('paneEstoque');if(pane&&!pane.hidden)loadStockTab();};

  // ---------- usuarios tab ----------
  function referralCodeForUser(id, data){
    const base=String((data&&data.name)||'PUFF').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,10)||'PUFF';
    return (base+'-'+String(id).replace(/[^a-zA-Z0-9]/g,'').slice(-6)).toUpperCase();
  }
  function loadUsersTab(){
    const activeEl = document.getElementById('statActiveNow');
    const totalEl = document.getElementById('statTotalUsers');
    const list = document.getElementById('adminUsersList');
    const search = document.getElementById('adminUserSearch');
    activeEl.textContent = '…'; totalEl.textContent = '…';
    if(list) list.innerHTML='<p class="admin-empty">Carregando usuários…</p>';
    db.collection('users').get().then(snap => {
      totalEl.textContent = snap.size;
      const cutoff = Date.now() - 15 * 60 * 1000;
      let active = 0;
      const users=snap.docs.map(doc=>{const d=doc.data()||{};const ts=d.lastSeen&&d.lastSeen.toMillis?d.lastSeen.toMillis():0;if(ts>=cutoff)active++;return{id:doc.id,...d};});
      activeEl.textContent = active;
      users.sort((a,b)=>String(a.name||a.email||'').localeCompare(String(b.name||b.email||''),'pt-BR'));
      const renderUsers=()=>{
        if(!list) return;
        const term=String(search?.value||'').trim().toLowerCase();
        const filtered=users.filter(u=>[u.name,u.email,u.referralCode,u.referredByCode].some(v=>String(v||'').toLowerCase().includes(term)));
        if(!filtered.length){list.innerHTML='<p class="admin-empty">Nenhum usuário encontrado.</p>';return;}
        list.innerHTML=filtered.map(u=>{
          const rate=Number(u.referralCommissionPercent||10);
          return `<div class="admin-user-row" data-user-id="${esc(u.id)}"><div class="admin-user-main"><div class="admin-user-name">${esc(u.name||'Sem nome')}</div><div class="admin-user-email">${esc(u.email||'Sem e-mail')}</div>${u.referralEnabled&&u.referralCode?`<div class="admin-user-ref">${esc(u.referralCode)}</div>`:''}${u.referredByCode?`<div class="admin-user-referred">Indicado por: ${esc(u.referredByCode)}</div>`:''}</div><div class="admin-user-actions"><select class="admin-rate-select" data-ref-rate="${esc(u.id)}" ${u.referralEnabled?'':'disabled'}><option value="10" ${rate===10?'selected':''}>10%</option><option value="15" ${rate===15?'selected':''}>15%</option><option value="20" ${rate===20?'selected':''}>20%</option></select><button class="admin-ref-btn ${u.referralEnabled?'enabled':''}" type="button" data-ref-enable="${esc(u.id)}">${u.referralEnabled?'Código liberado':'Liberar código de convite'}</button></div></div>`;
        }).join('');
        list.querySelectorAll('[data-ref-enable]').forEach(btn=>btn.addEventListener('click',async()=>{
          const uid=btn.dataset.refEnable; const u=users.find(x=>x.id===uid); if(!u) return;
          btn.disabled=true;
          try{
            if(!u.referralEnabled){
              const code=u.referralCode||referralCodeForUser(uid,u);
              await db.collection('users').doc(uid).set({referralEnabled:true,referralCode:code,referralCommissionPercent:10,referralEnabledAt:firebase.firestore.FieldValue.serverTimestamp()},{merge:true});
              u.referralEnabled=true;u.referralCode=code;u.referralCommissionPercent=10;
            }
            renderUsers();
          }catch(err){console.error(err);alert('Não foi possível liberar o código. Verifique as regras do Firestore para o administrador.');btn.disabled=false;}
        }));
        list.querySelectorAll('[data-ref-rate]').forEach(sel=>sel.addEventListener('change',async()=>{
          const uid=sel.dataset.refRate; const rate=Number(sel.value); const u=users.find(x=>x.id===uid); if(!u||!u.referralEnabled||![10,15,20].includes(rate))return;
          sel.disabled=true;
          try{await db.collection('users').doc(uid).set({referralCommissionPercent:rate,referralCommissionUpdatedAt:firebase.firestore.FieldValue.serverTimestamp()},{merge:true});u.referralCommissionPercent=rate;}catch(err){console.error(err);alert('Não foi possível alterar a comissão.');}finally{sel.disabled=false;}
        }));
      };
      if(search && !search.dataset.bound){ search.dataset.bound='1'; search.addEventListener('input',renderUsers); }
      renderUsers();
    }).catch(err => { console.error(err); activeEl.textContent='–'; totalEl.textContent='–'; if(list)list.innerHTML='<p class="admin-empty">Não foi possível carregar os usuários.</p>'; });
  }

  async function loadReferralsTab(){
    const list=document.getElementById('adminReferralsList');
    const withdrawals=document.getElementById('adminWithdrawalsList');
    const refCount=document.getElementById('statReferrers');
    const invitedCount=document.getElementById('statReferredUsers');
    list.innerHTML='<p class="admin-empty">Carregando indicadores…</p>'; withdrawals.innerHTML='<p class="admin-empty">Carregando saques…</p>';
    try{
      const snap=await db.collection('users').get();
      const users=snap.docs.map(d=>({id:d.id,...(d.data()||{})}));
      const active=users.filter(u=>u.referralEnabled&&u.referralCode);
      const invited=users.filter(u=>u.referredByUid);
      refCount.textContent=active.length; invitedCount.textContent=invited.length;
      if(!active.length) list.innerHTML='<p class="admin-empty">Nenhum link de convite ativo.</p>';
      else list.innerHTML=active.map(u=>{
        const people=invited.filter(i=>i.referredByUid===u.id);
        const details=people.length?`<div class="admin-referral-invites">${people.map(p=>`<div class="admin-referral-invite"><span>${esc(p.name||p.email||'Usuário')}</span><span>${esc(p.email||'')}</span></div>`).join('')}</div>`:'<div class="admin-referral-meta" style="margin-top:9px">Ainda não convidou ninguém.</div>';
        return `<div class="admin-referral-row"><div class="admin-referral-head"><div><div class="admin-referral-name">${esc(u.name||'Sem nome')}</div><div class="admin-referral-meta">${esc(u.email||'')}</div><div class="admin-referral-code">${esc(u.referralCode)}</div></div><div class="admin-referral-numbers"><strong>${people.length}</strong> indicados<br>${Number(u.referralCommissionPercent||10)}% comissão<br>${formatAdminMoney(u.referralEarningsTotal||0)} ganhos</div></div>${details}</div>`;
      }).join('');
      await loadWithdrawalRequests();
    }catch(err){console.error(err);list.innerHTML='<p class="admin-empty">Não foi possível carregar os indicadores.</p>';withdrawals.innerHTML='<p class="admin-empty">Não foi possível carregar os saques.</p>';}
  }
  function formatAdminMoney(v){return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});}
  async function loadWithdrawalRequests(){
    const el=document.getElementById('adminWithdrawalsList');
    try{
      const snap=await db.collection('referralWithdrawals').get();
      const rows=snap.docs.map(d=>({id:d.id,...(d.data()||{})})).sort((a,b)=>{const ta=a.createdAt&&a.createdAt.toMillis?a.createdAt.toMillis():0;const tb=b.createdAt&&b.createdAt.toMillis?b.createdAt.toMillis():0;return tb-ta;});
      if(!rows.length){el.innerHTML='<p class="admin-empty">Nenhuma solicitação de saque.</p>';return;}
      el.innerHTML=rows.map(w=>`<div class="admin-withdrawal-row"><div class="admin-user-name">${esc(w.userName||w.userEmail||w.uid||'Usuário')} · ${formatAdminMoney(w.amount||0)}</div><div class="admin-user-email">Pix (${esc(w.pixType||'')}): ${esc(w.pixKey||'')}</div><div class="admin-user-referred">Status: ${esc(w.status||'pending')}</div>${w.status==='pending'?`<div class="admin-withdrawal-actions"><button class="paid" data-withdraw-action="paid" data-id="${esc(w.id)}">Marcar como pago</button><button class="reject" data-withdraw-action="reject" data-id="${esc(w.id)}">Rejeitar e devolver saldo</button></div>`:''}</div>`).join('');
      el.querySelectorAll('[data-withdraw-action]').forEach(btn=>btn.addEventListener('click',async()=>{
        if(!confirm(btn.dataset.withdrawAction==='paid'?'Confirma que o Pix deste saque já foi realizado?':'Rejeitar o saque e devolver o valor ao saldo disponível?'))return;
        btn.disabled=true;
        try{const user=window.auth.currentUser;const token=await user.getIdToken(true);const r=await fetch('/api/referral-admin',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify({action:btn.dataset.withdrawAction==='paid'?'markPaid':'reject',withdrawalId:btn.dataset.id})});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Falha ao atualizar saque.');await loadWithdrawalRequests();}catch(err){alert(err.message||'Falha ao atualizar saque.');btn.disabled=false;}
      }));
    }catch(err){console.error(err);el.innerHTML='<p class="admin-empty">Não foi possível carregar os saques.</p>';}
  }

  // ---------- vendas tab ----------
  const periodBtns = modal.querySelectorAll('.admin-period-btn');
  periodBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      periodBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      loadSalesTab(btn.dataset.period);
    });
  });
  function loadSalesTab(period){
    const countEl = document.getElementById('statOrderCount');
    const totalEl = document.getElementById('statOrderTotal');
    countEl.textContent = '…';
    totalEl.textContent = '…';
    const days = period === 'day' ? 1 : (period === 'week' ? 7 : 30);
    const since = new Date();
    since.setDate(since.getDate() - days);
    db.collection('orders').where('createdAt', '>=', since).get().then(snap => {
      let count = 0, sum = 0;
      snap.forEach(doc => {
        const d = doc.data();
        count++;
        sum += Number(d.total) || 0;
      });
      countEl.textContent = count;
      totalEl.textContent = 'R$ ' + sum.toFixed(2).replace('.', ',');
    }).catch(() => { countEl.textContent = '–'; totalEl.textContent = '–'; });
  }

  // ---------- pedidos tab ----------
  function esc(v){return String(v??'').replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]));}
  function orderDate(v){try{const d=v&&v.toDate?v.toDate():new Date(v);return isNaN(d)?'—':d.toLocaleString('pt-BR');}catch(e){return '—';}}
  function loadOrdersTab(){
    const list=document.getElementById('adminOrdersList');
    list.innerHTML='<p class="admin-empty">Carregando pedidos…</p>';
    db.collection('orders').get().then(snap=>{
      const orders=snap.docs.map(d=>({id:d.id,...d.data()}));
      orders.sort((a,b)=>{const ta=a.createdAt&&a.createdAt.toMillis?a.createdAt.toMillis():0;const tb=b.createdAt&&b.createdAt.toMillis?b.createdAt.toMillis():0;return tb-ta;});
      if(!orders.length){list.innerHTML='<p class="admin-empty">Nenhum pedido registrado ainda.</p>';return;}
      list.innerHTML=orders.map(o=>{
        const paid=String(o.paymentStatus||o.status||'').toLowerCase()==='paid';
        const status=paid?'Pago':(String(o.paymentStatus||o.status||'').includes('pending')?'Aguardando':'Pendente');
        const d=o.delivery||{};
        const address=[d.street,d.number,d.complement,d.neighborhood,d.city,d.state,d.cep].filter(Boolean).join(' · ');
        const phone=String(o.phone||'').replace(/\D/g,'');
        const wa=phone?`https://wa.me/55${phone}?text=${encodeURIComponent('Olá '+(o.name||'')+'! Aqui é a Puffpod sobre o pedido '+(o.orderId||o.id)+'.')}`:'';
        const mail=o.email?`mailto:${encodeURIComponent(o.email)}?subject=${encodeURIComponent('Pedido '+(o.orderId||o.id)+' — Puffpod')}`:'';
        return `<div class="admin-order-row">
          <div>
            <div class="admin-order-code">${esc(o.orderId||o.id)}</div>
            <div class="admin-order-name">${esc(o.name||'Cliente')}</div>
            <div class="admin-order-meta">${esc(o.email||'Sem e-mail')} ${phone?'· '+esc(o.phone):''}<br>${orderDate(o.createdAt)}</div>
            ${address?`<div class="admin-order-address">Entrega: ${esc(address)}</div>`:''}
          </div>
          <div class="admin-order-side">
            <div class="admin-order-total">R$ ${(Number(o.total)||0).toFixed(2).replace('.',',')}</div>
            <span class="admin-order-status ${paid?'paid':'pending'}">${status}</span>
            <div class="admin-order-actions">
              ${wa?`<a class="admin-mini-btn" href="${wa}" target="_blank" rel="noopener noreferrer">WhatsApp</a>`:''}
              ${mail?`<a class="admin-mini-btn" href="${mail}">E-mail</a>`:''}
            </div>
          </div>
        </div>`;
      }).join('');
    }).catch(err=>{console.error(err);list.innerHTML='<p class="admin-empty">Não foi possível carregar os pedidos agora.</p>';});
  }

  // ---------- não compraram tab ----------
  function loadNonBuyersTab(){
    const list = document.getElementById('adminNonBuyersList');
    list.innerHTML = '<p class="admin-empty">Carregando…</p>';
    Promise.all([
      db.collection('users').get(),
      db.collection('orders').get()
    ]).then(([usersSnap, ordersSnap]) => {
      const buyerEmails = new Set();
      ordersSnap.forEach(doc => {
        const email = doc.data().email;
        if(email) buyerEmails.add(email.toLowerCase());
      });
      const nonBuyers = [];
      usersSnap.forEach(doc => {
        const d = doc.data();
        if(d.email && !buyerEmails.has(d.email.toLowerCase())){
          nonBuyers.push(d);
        }
      });
      if(nonBuyers.length === 0){
        list.innerHTML = '<p class="admin-empty">Todo mundo que se cadastrou já comprou 🎉</p>';
        return;
      }
      list.innerHTML = nonBuyers.map(u => {
        const name = u.name || u.email;
        const mailtoHref = `mailto:${u.email}?subject=${encodeURIComponent('Aproveite seu cashback na Puffpod!')}&body=${encodeURIComponent('Olá ' + (u.name || '') + '! Notamos que você criou uma conta na Puffpod mas ainda não fez seu primeiro pedido. Que tal aproveitar? :)')}`;
        const waHref = u.phone
          ? `https://wa.me/55${u.phone.replace(/\D/g,'')}?text=${encodeURIComponent('Olá ' + (u.name || '') + '! Vi que você se cadastrou na Puffpod mas ainda não comprou. Posso te ajudar a escolher um produto?')}`
          : '';
        return `
          <div class="admin-nonbuyer-row">
            <div class="info">
              <div class="name">${name}</div>
              <div class="email">${u.email}</div>
            </div>
            <a class="admin-mini-btn" href="${mailtoHref}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
              E-mail
            </a>
            ${waHref ? `<a class="admin-mini-btn" href="${waHref}" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.36.66 4.56 1.8 6.44L4 29l7.7-1.76a11.94 11.94 0 0 0 4.32.8h.01c6.62 0 12.02-5.4 12.02-12.02C28.05 8.4 22.65 3 16.02 3Z"/></svg>
              WhatsApp
            </a>` : ''}
          </div>
        `;
      }).join('');
    }).catch(() => { list.innerHTML = '<p class="admin-empty">Não foi possível carregar agora.</p>'; });
  }
})();
</script>

</body>
</html>
